@page "/features"
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Linq

<PageTitle>Features</PageTitle>

<h1>Features</h1>


@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>MP</th>
                <th>Wounds</th>
                <th>Armor</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in features)
            {
                <tr>
                    <td>@f.Name</td>
                    <td>@f.MP</td>
                    <td>@f.Wounds</td>
                    <td>@f.Armor</td>
                    <td>@f.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private int currentCount = 0;
    private List<FeatureDto> features = new();
    private bool featuresLoaded = false;
    private string? saveMessage = "Loading features...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || featuresLoaded)
            return;

        try
        {
            // Load features from server API (client runtime)
            features = await Http.GetFromJsonAsync<List<FeatureDto>>("api/features") ?? new List<FeatureDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load features: {ex.Message}";

            featuresLoaded = true;
        }
        saveMessage = "";
        featuresLoaded = true;

        // State has changed because data loaded after render
        StateHasChanged();
    }

    private class FeatureDto
    {
        public string? Name { get; set; }
        public int MP { get; set; }
        public int Wounds { get; set; }
        public string? Armor { get; set; }
        public string? Description { get; set; }
    }
}
