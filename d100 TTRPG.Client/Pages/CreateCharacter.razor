    private void OnFeatureSelected(
        int slot,
        ChangeEventArgs e)
    {
        var name = e.Value?.ToString();

        // Clear prior warning
        featureWarnings.Remove(slot);

        if (string.IsNullOrEmpty(name))
        {
            // Clearing selection: remove prior applied bonuses
            // for that slot by reapplying all selected features.
            SetFeatureSlot(slot, null);
            ReapplyAllBonusesSkillsTalentsTraits();
            return;
        }

        var f = features.FirstOrDefault(
            x => x.Name == name);

        if (f == null)
        {
            featureWarnings[slot] = "Feature not found.";
            SetFeatureSlot(slot, null);
            ReapplyAllBonusesSkillsTalentsTraits();
            return;
        }

        // Check prerequisites
        foreach (var kv in f.PreReqChar)
        {
            var stat = kv.Key;
            var req = kv.Value;

            featureBonuses.TryGetValue(
                stat,
                out var fb);

            currentStats.TryGetValue(
                stat,
                out var cur);

            var effective = cur + fb;

            if (effective < req)
            {
                featureWarnings[slot] =
                    $"Prerequisite not met: {stat} >= {req} required (current {effective})";

                SetFeatureSlot(slot, null);
                ReapplyAllBonusesSkillsTalentsTraits();

                return;
            }
        }

        // Valid feature
        SetFeatureSlot(slot, name);

        ReapplyAllBonusesSkillsTalentsTraits();
    }

    private void SetFeatureSlot(
        int slot,
        string? name)
    {
        switch (slot)
        {
            case 1:
                feature1 = name;
                break;

            case 2:
                feature2 = name;
                break;

            case 3:
                feature3 = name;
                break;

            case 4:
                feature4 = name;
                break;
        }
    }

    private void ReapplyAllBonusesSkillsTalentsTraits()
    {
        featureBonuses.Clear();
        skillCounts.Clear();

        totalFeatureMP = 0;
        totalFeatureWounds = 0;

        // ------------------------------------------------------------
        // Apply Features
        // ------------------------------------------------------------

        var selectedFeatures = new[]
        {
        feature1,
        feature2,
        feature3,
        feature4
    };

        foreach (var fname in selectedFeatures)
        {
            if (string.IsNullOrEmpty(fname))
                continue;

            var f = features.FirstOrDefault(
                x => x.Name == fname);

            if (f == null)
                continue;

            foreach (var cb in f.CharBonuses)
            {
                featureBonuses.TryGetValue(
                    cb,
                    out var cur);

                featureBonuses[cb] =
                    cur + 5;
            }

            foreach (var sk in f.Skills)
            {
                skillCounts.TryGetValue(
                    sk,
                    out var sc);

                skillCounts[sk] =
                    sc + 1;
            }

            totalFeatureMP += f.MP;
            totalFeatureWounds += f.Wounds;
        }

        // ------------------------------------------------------------
        // Apply Background
        // ------------------------------------------------------------

        if (!string.IsNullOrEmpty(selectedBackground))
        {
            var b = backgrounds.FirstOrDefault(
                x => x.Name == selectedBackground);

            if (b != null)
            {
                if (b.Skills != null)
                {
                    foreach (var sk in b.Skills)
                    {
                        skillCounts.TryGetValue(
                            sk,
                            out var sc);

                        skillCounts[sk] =
                            sc + 1;
                    }
                }
            }
        }

        // ------------------------------------------------------------
        // Apply Aristocrat Extra Skills
        //
        // These are intentionally applied only when the current
        // background is Aristocrat.
        // ------------------------------------------------------------

        if (IsAristocratBackground)
        {
            if (!string.IsNullOrEmpty(selectedBackgroundExtraSkill1))
            {
                skillCounts.TryGetValue(
                    selectedBackgroundExtraSkill1,
                    out var sc);

                skillCounts[selectedBackgroundExtraSkill1] =
                    sc + 1;
            }

            if (!string.IsNullOrEmpty(selectedBackgroundExtraSkill2))
            {
                skillCounts.TryGetValue(
                    selectedBackgroundExtraSkill2,
                    out var sc);

                skillCounts[selectedBackgroundExtraSkill2] =
                    sc + 1;
            }
        }

        // ------------------------------------------------------------
        // Apply Trade
        // ------------------------------------------------------------

        if (!string.IsNullOrEmpty(selectedTrade))
        {
            var t = trades.FirstOrDefault(
                x => x.Name == selectedTrade);

            if (t != null && t.Skills != null)
            {
                foreach (var sk in t.Skills)
                {
                    skillCounts.TryGetValue(
                        sk,
                        out var sc);

                    skillCounts[sk] =
                        sc + 1;
                }
            }
        }

        // ------------------------------------------------------------
        // Apply Motivation
        // ------------------------------------------------------------

        if (!string.IsNullOrEmpty(selectedMotivation))
        {
            var m = motivations.FirstOrDefault(
                x => x.Name == selectedMotivation);

            if (m != null && m.Skills != null)
            {
                foreach (var sk in m.Skills)
                {
                    skillCounts.TryGetValue(
                        sk,
                        out var sc);

                    skillCounts[sk] =
                        sc + 1;
                }
            }
        }
    }

    private int GetTotalWounds()
    {
        var baseWounds = 0;

        if (!string.IsNullOrEmpty(selectedRace))
        {
            var r = races.FirstOrDefault(
                x => x.Name == selectedRace);

            if (r != null)
                baseWounds = r.Wounds;
        }

        var con =
            currentStats.ContainsKey("CON")
                ? currentStats["CON"]
                : (baseStats.ContainsKey("CON")
                    ? baseStats["CON"]
                    : 0);

        featureBonuses.TryGetValue(
            "CON",
            out var fb);

        var effectiveCon =
            con + fb;

        return
            baseWounds +
            totalFeatureWounds +
            (effectiveCon / 10);
    }

    private int GetTotalMP()
    {
        return totalFeatureMP;
    }

    private int GetArmorPoints()
    {
        int armorPoints = 0;

        if (!string.IsNullOrEmpty(selectedArmor))
        {
            var a = armors.FirstOrDefault(
                x => x.Name == selectedArmor);

            if (a != null && a.ArmorPoints.HasValue)
            {
                armorPoints =
                    a.ArmorPoints.Value;
            }
        }

        // Add CON bonus
        var con =
            currentStats.ContainsKey("CON")
                ? currentStats["CON"]
                : (baseStats.ContainsKey("CON")
                    ? baseStats["CON"]
                    : 0);

        featureBonuses.TryGetValue(
            "CON",
            out var fb);

        var effectiveCon =
            con + fb;

        armorPoints +=
            effectiveCon / 10;

        return armorPoints;
    }

    private string GetSkillRank(int count)
    {
        return count switch
        {
            1 => "Trained",
            2 => "Proficient",
            3 => "Adept",
            >= 4 => "Expert",
            _ => ""
        };
    }

