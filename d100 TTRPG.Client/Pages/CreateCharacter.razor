@page "/create-character"
@rendermode InteractiveAuto

@inject HttpClient Http

<PageTitle>Create Character</PageTitle>

<h1>Create Character</h1>

<div class="card p-3">
    <div class="mb-3">
        <label class="form-label">Power Level</label>
        <select class="form-select" @onchange="OnPowerLevelChanged">
            <option value="">(Select a power level)</option>
            @foreach (var p in powerLevels)
            {
                <option value="@p.Name" selected="@(selectedPowerLevel != null && p.Name == selectedPowerLevel.Name)">
                    @p.Name (@p.Points pts, @p.Features features)
                </option>
            }
        </select>
    </div>

    <div class="card p-3 mt-3">
        <h5>Derived</h5>
        <div class="row">
            <div class="col-md-6">
                <div><strong>Wounds</strong>: @GetTotalWounds()</div>
                <div><strong>MP</strong>: @GetTotalMP()</div>
                <div><strong>Armor Points</strong>: @GetArmorPoints()</div>
            </div>

            <div class="col-md-6">
                <h6>Skills</h6>

                @if (skillCounts.Any())
                {
                    <ul>
                        @foreach (var kv in skillCounts)
                        {
                            <li>@kv.Key - @GetSkillRank(kv.Value)</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted">No skills from features.</div>
                }
            </div>
        </div>

        <div class="mt-3">
            <h6>Spells available</h6>

            @if (spells != null && spells.Any())
            {
                <div class="mb-2">
                    <button class="btn btn-sm btn-outline-secondary me-2" @onclick="AddXP">+50 XP</button>
                    <span>XP pool: <strong>@xpPool</strong></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h6>Available</h6>

                        @foreach (var s in spells.Where(s => s.MP <= GetTotalMP()).OrderBy(s => s.Name))
                        {
                            <div>
                                <input type="checkbox"
                                       @onchange="e => OnSpellToggled(s.Name, s.XpCost, e)"
                                       checked="@(learnedSpells.Contains(s.Name))" />

                                <label class="ms-1">@s.Name (@s.XpCost xp)</label>
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <h6>Learned</h6>

                        @if (learnedSpells.Any())
                        {
                            <ul>
                                @foreach (var ls in learnedSpells)
                                {
                                    <li>@ls</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted">No learned spells.</div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-muted">No spells loaded.</div>
            }
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Location</label>

        <select class="form-select" @onchange="OnLocationChanged">
            <option value="">(Select a location)</option>

            @foreach (var loc in locations)
            {
                <option value="@loc.Name" selected="@(loc.Name == selectedLocation)">
                    @loc.Name
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Race</label>

        <select class="form-select" @onchange="OnRaceChanged">
            <option value="">(Select a race)</option>

            @foreach (var r in raceOptions)
            {
                <option value="@r" selected="@(r == selectedRace)">
                    @r
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Character Name</label>

        <input class="form-control"
               @bind="characterName"
               placeholder="Character name (used for filename)" />
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Background</label>

            <select class="form-select" @onchange="OnBackgroundSelected">
                <option value="">(Select background)</option>

                @foreach (var b in backgrounds)
                {
                    <option value="@b.Name" selected="@(selectedBackground == b.Name)">
                        @b.Name
                    </option>
                }
            </select>

            @if (IsAristocratBackground)
            {
                <div class="mt-3">
                    <label class="form-label">Additional Skill 1</label>

                    <select class="form-select" @onchange="OnBackgroundExtraSkill1Changed">
                        <option value="">(Select skill)</option>

                        @foreach (var skill in GetAvailableAristocratSkills(1))
                        {
                            <option value="@skill.Name" selected="@(selectedBackgroundExtraSkill1 == skill.Name)">
                                @skill.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="mt-3">
                    <label class="form-label">Additional Skill 2</label>

                    <select class="form-select" @onchange="OnBackgroundExtraSkill2Changed">
                        <option value="">(Select skill)</option>

                        @foreach (var skill in GetAvailableAristocratSkills(2))
                        {
                            <option value="@skill.Name" selected="@(selectedBackgroundExtraSkill2 == skill.Name)">
                                @skill.Name
                            </option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Trade</label>

            <select class="form-select" @onchange="OnTradeSelected">
                <option value="">(Select trade)</option>

                @foreach (var t in trades)
                {
                    <option value="@t.Name" selected="@(selectedTrade == t.Name)">
                        @t.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Motivation</label>

            <select class="form-select" @onchange="OnMotivationSelected">
                <option value="">(Select motivation)</option>

                @foreach (var m in motivations)
                {
                    <option value="@m.Name" selected="@(selectedMotivation == m.Name)">
                        @m.Name
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Feature 1</label>

            <select class="form-select" @onchange="e => OnFeatureSelected(1, e)">
                <option value="">(Select feature)</option>

                @foreach (var f in features)
                {
                    <option value="@f.Name" selected="@(feature1 == f.Name)">
                        @f.Name
                    </option>
                }
            </select>

            @if (featureWarnings.ContainsKey(1))
            {
                <div class="text-danger mt-1">@featureWarnings[1]</div>
            }
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Feature 2</label>

            <select class="form-select" @onchange="e => OnFeatureSelected(2, e)">
                <option value="">(Select feature)</option>

                @foreach (var f in features)
                {
                    <option value="@f.Name" selected="@(feature2 == f.Name)">
                        @f.Name
                    </option>
                }
            </select>

            @if (featureWarnings.ContainsKey(2))
            {
                <div class="text-danger mt-1">@featureWarnings[2]</div>
            }
        </div>

        @if (allowedFeatures >= 3)
        {
            <div class="col-md-4 mb-3">
                <label class="form-label">Feature 3</label>

                <select class="form-select" @onchange="e => OnFeatureSelected(3, e)">
                    <option value="">(Select feature)</option>

                    @foreach (var f in features)
                    {
                        <option value="@f.Name" selected="@(feature3 == f.Name)">
                            @f.Name
                        </option>
                    }
                </select>

                @if (featureWarnings.ContainsKey(3))
                {
                    <div class="text-danger mt-1">@featureWarnings[3]</div>
                }
            </div>
        }

        @if (allowedFeatures >= 4)
        {
            <div class="col-md-4 mb-3">
                <label class="form-label">Feature 4</label>

                <select class="form-select" @onchange="e => OnFeatureSelected(4, e)">
                    <option value="">(Select feature)</option>

                    @foreach (var f in features)
                    {
                        <option value="@f.Name" selected="@(feature4 == f.Name)">
                            @f.Name
                        </option>
                    }
                </select>

                @if (featureWarnings.ContainsKey(4))
                {
                    <div class="text-danger mt-1">@featureWarnings[4]</div>
                }
            </div>
        }
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card p-3">
                <h5>Character Sheet</h5>

                <div class="mb-2">
                    Points available: <strong>@availablePoints</strong>
                </div>

                @if (baseStats != null && baseStats.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Stat</th>
                                <th>Value</th>
                                <th>Feat</th>
                                <th>Bonus</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var key in new[] { "MSK", "RSK", "STR", "AGI", "CON", "INT", "PER", "WPR", "CHA" })
                            {
                                var baseVal = baseStats.ContainsKey(key) ? baseStats[key] : 0;
                                var curVal = currentStats.ContainsKey(key) ? currentStats[key] : baseVal;

                                featureBonuses.TryGetValue(key, out var fb);

                                var effective = curVal + fb;
                                var charBonus = effective / 10;

                                <tr>
                                    <td>@key</td>

                                    <td>
                                        @effective

                                        @if (fb > 0)
                                        {
                                            <small class="text-success">(+@fb)</small>
                                        }
                                    </td>

                                    <td>@fb</td>
                                    <td>@charBonus</td>

                                    <td>
                                        <button class="btn btn-sm btn-secondary me-1"
                                                @onclick="() => DecreaseStat(key)"
                                                disabled="@(curVal <= baseVal + 5)">
                                            -
                                        </button>

                                        <button class="btn btn-sm btn-secondary"
                                                @onclick="() => IncreaseStat(key)"
                                                disabled="@(availablePoints < 5 || curVal >= baseVal + 20)">
                                            +
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">
                        Select a race to populate base statistics.
                    </p>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3">
                <h5>Equipment</h5>

                <div class="mb-3">
                    <label class="form-label">Armor</label>

                    <select class="form-select" @bind="selectedArmor">
                        <option value="">(Select armor)</option>

                        @foreach (var a in armors)
                        {
                            <option value="@a.Name">
                                @a.Name (@a.ArmorPoints)
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Main hand</label>

                    <select class="form-select" @onchange="OnMainWeaponChanged">
                        <option value="">(Select main weapon)</option>

                        @foreach (var w in weapons.Where(w =>
                            !(w.Hands?.Contains("Shield") ?? false) &&
                            !(w.Hands?.Contains("TowerShield") ?? false) &&
                            !(w.Hands?.Contains("Armor") ?? false)))
                        {
                            <option value="@w.Name" selected="@(w.Name == selectedMainWeapon)">
                                @w.Name (@w.Hands / @w.Range)
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Off hand</label>

                    <select class="form-select"
                            @bind="selectedOffWeapon"
                            disabled="@IsOffhandDisabled()">
                        <option value="">(Select off-hand)</option>

                        @foreach (var w in weapons)
                        {
                            <option value="@w.Name">
                                @w.Name (@w.Hands)
                            </option>
                        }
                    </select>

                    @if (IsOffhandDisabled())
                    {
                        <div class="form-text">
                            Off-hand disabled for two-handed or ranged main weapons.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="Submit">
            Create
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3">
            @message
        </div>
    }
    ```

</div>

<div class="card p-3 mt-3">
    <h5>Save / Load</h5>

    ```
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <button class="btn btn-success"
                    @onclick="SaveCharacter"
                    disabled="@(!CanSave())">
                Save
            </button>
        </div>

        <div class="col-auto">
            <select class="form-select"
                    style="min-width:240px"
                    @bind="selectedSavedFile">
                <option value="">(Select saved file)</option>

                @foreach (var f in savedFiles)
                {
                    <option value="@f">@f</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <button class="btn btn-secondary"
                    @onclick="LoadCharacter"
                    disabled="@(string.IsNullOrEmpty(selectedSavedFile))">
                Load
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(saveMessage))
    {
        <div class="mt-2 text-muted">
            @saveMessage
        </div>
    }

    <div class="mt-3">
        <label class="form-label">
            Save base folder (optional)
        </label>

        <div class="input-group">
            <input class="form-control"
                   @bind="customBasePath"
                   placeholder="Enter base folder or leave empty for default" />

            <button class="btn btn-outline-primary"
                    @onclick="SetSavePath">
                Set
            </button>

            <button class="btn btn-outline-secondary"
                    @onclick="ResetSavePath">
                Reset to default
            </button>
        </div>

        <div class="form-text mt-1">
            Current save folder: @currentSaveFolder
        </div>
    </div>
    ```

</div>

@code {
    private List<LocationDto> locations = new();
    private List<string> raceOptions = new();
    private List<SimpleDto> backgrounds = new();
    private List<SimpleDto> trades = new();
    private List<SimpleDto> motivations = new();
    private List<FeatureDto> features = new();
    private List<WeaponDto> weapons = new();
    private List<ArmorDto> armors = new();
    private List<RaceDto> races = new();
    private List<PowerLevelDto> powerLevels = new();

private PowerLevelDto? selectedPowerLevel;
    private int allowedFeatures = 3;

    private string? selectedLocation;
    private string? selectedRace;
    private string? selectedBackground;
    private string? selectedTrade;
    private string? selectedMotivation;

    private string? feature1;
    private string? feature2;
    private string? feature3;
    private string? feature4;

    // Aristocrat additional skills
    private string? selectedBackgroundExtraSkill1;
    private string? selectedBackgroundExtraSkill2;

    // Aristocrat skills from the skills database.
    // The numeric IDs correspond to the supplied skillsdb values.
    private readonly List<SkillOption> aristocratSkillOptions = new()
{
    new SkillOption("Arcana", 23),
    new SkillOption("Engineering", 24),
    new SkillOption("History", 25),
    new SkillOption("Local", 26),
    new SkillOption("Nature", 27),
    new SkillOption("Religion", 28)
};

    // Feature related
    private Dictionary<string, int> featureBonuses = new();
    private Dictionary<string, int> skillCounts = new();

    private int totalFeatureWounds = 0;
    private int totalFeatureMP = 0;

    private Dictionary<int, string> featureWarnings = new();

    private string? selectedArmor;
    private string? selectedMainWeapon;
    private string? selectedOffWeapon;

    // Characteristic scores
    private Dictionary<string, int> baseStats = new();
    private Dictionary<string, int> currentStats = new();
    private int availablePoints = 120;

    private string? message;
    private string? characterName;

    private List<string> savedFiles = new();
    private string? selectedSavedFile;
    private string? saveMessage;

    private DiagnosticsInfo? diagnostics;
    private string? customBasePath;
    private string? currentSaveFolder;

    private List<SpellDto> spells = new();
    private int xpPool = 1000;

    private bool lookupsLoaded = false;

    private HashSet<string> learnedSpells = new();

    private bool IsAristocratBackground =>
        string.Equals(selectedBackground, "Aristocrat", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || lookupsLoaded)
            return;

        // Only perform HTTP fetches when running in the browser to avoid server prerender HTTP calls
        if (!OperatingSystem.IsBrowser())
        {
            lookupsLoaded = true;
            return;
        }

        try
        {
            // Load lookups
            locations = await Http.GetFromJsonAsync<List<LocationDto>>("api/locations")
                ?? new List<LocationDto>();

            backgrounds = await Http.GetFromJsonAsync<List<SimpleDto>>("api/backgrounds")
                ?? new List<SimpleDto>();

            trades = await Http.GetFromJsonAsync<List<SimpleDto>>("api/trades")
                ?? new List<SimpleDto>();

            motivations = await Http.GetFromJsonAsync<List<SimpleDto>>("api/motivations")
                ?? new List<SimpleDto>();

            features = await Http.GetFromJsonAsync<List<FeatureDto>>("api/features")
                ?? new List<FeatureDto>();

            weapons = await Http.GetFromJsonAsync<List<WeaponDto>>("api/weapons")
                ?? new List<WeaponDto>();

            armors = await Http.GetFromJsonAsync<List<ArmorDto>>("api/armor")
                ?? new List<ArmorDto>();

            // Load spells for character spell list
            try
            {
                spells = await Http.GetFromJsonAsync<List<SpellDto>>("api/spells")
                    ?? new List<SpellDto>();
            }
            catch
            {
                spells = new List<SpellDto>();
            }

            races = await Http.GetFromJsonAsync<List<RaceDto>>("api/races")
                ?? new List<RaceDto>();

            powerLevels = await Http.GetFromJsonAsync<List<PowerLevelDto>>("api/powerlevels")
                ?? new List<PowerLevelDto>();

            // Default power level to Standard if present
            selectedPowerLevel =
                powerLevels.FirstOrDefault(p => p.Name == "Standard")
                ?? powerLevels.FirstOrDefault();

            if (selectedPowerLevel != null)
            {
                allowedFeatures = selectedPowerLevel.Features;

                // Reserve mandatory +5 per stat
                var mandatory = 9 * 5;

                availablePoints = Math.Max(
                    0,
                    selectedPowerLevel.Points - mandatory);
            }
        }
        catch (System.Net.Http.HttpRequestException)
        {
            // API not available
            locations = new List<LocationDto>();
            backgrounds = new List<SimpleDto>();
            trades = new List<SimpleDto>();
            motivations = new List<SimpleDto>();
            features = new List<FeatureDto>();

            saveMessage = "Unable to load lookups - server API not available.";
        }

        lookupsLoaded = true;

        // Load saved files and diagnostics
        await LoadSavedFiles();
        await LoadDiagnostics();

        if (diagnostics != null)
            currentSaveFolder = diagnostics.SaveFolder;

        StateHasChanged();
    }

    private Task OnLocationChanged(ChangeEventArgs e)
    {
        selectedLocation = e.Value?.ToString();

        var loc = locations.FirstOrDefault(l => l.Name == selectedLocation);

        raceOptions = loc?.Races ?? new List<string>();
        selectedRace = null;

        return Task.CompletedTask;
    }

    private void OnRaceChanged(ChangeEventArgs e)
    {
        selectedRace = e.Value?.ToString();

        var r = races.FirstOrDefault(x => x.Name == selectedRace);

        if (r != null)
        {
            baseStats = new Dictionary<string, int>
            {
                ["MSK"] = r.MSK,
                ["RSK"] = r.RSK,
                ["STR"] = r.STR,
                ["AGI"] = r.AGI,
                ["CON"] = r.CON,
                ["INT"] = r.INT,
                ["PER"] = r.PER,
                ["WPR"] = r.WPR,
                ["CHA"] = r.CHA
            };

            // Initialize current stats to base + mandatory +5 per stat
            currentStats = baseStats.ToDictionary(
                kv => kv.Key,
                kv => kv.Value + 5);

            var mandatory = 9 * 5;

            if (selectedPowerLevel != null)
            {
                availablePoints = Math.Max(
                    0,
                    selectedPowerLevel.Points - mandatory);

                allowedFeatures = selectedPowerLevel.Features;
            }
            else
            {
                availablePoints = Math.Max(0, 120 - mandatory);
            }
        }
        else
        {
            baseStats.Clear();
            currentStats.Clear();
        }
    }

    private void OnMainWeaponChanged(ChangeEventArgs e)
    {
        selectedMainWeapon = e.Value?.ToString();

        var w = weapons.FirstOrDefault(x => x.Name == selectedMainWeapon);

        if (w != null)
        {
            bool disableOff = false;

            if (!string.IsNullOrEmpty(w.Hands) &&
                w.Hands.Contains("TwoHanded"))
            {
                disableOff = true;
            }

            if (!string.IsNullOrEmpty(w.Range) &&
                !w.Range.Contains("Melee"))
            {
                disableOff = true;
            }

            if (disableOff)
            {
                selectedOffWeapon = null;
            }
        }
    }

    private void OnPowerLevelChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();

        selectedPowerLevel = powerLevels.FirstOrDefault(
            p => p.Name == name);

        if (selectedPowerLevel != null)
        {
            allowedFeatures = selectedPowerLevel.Features;

            var mandatory = 9 * 5;

            availablePoints = Math.Max(
                0,
                selectedPowerLevel.Points - mandatory);
        }
    }

    private bool IsOffhandDisabled()
    {
        if (string.IsNullOrEmpty(selectedMainWeapon))
            return false;

        var w = weapons.FirstOrDefault(
            x => x.Name == selectedMainWeapon);

        if (w == null)
            return false;

        if (!string.IsNullOrEmpty(w.Hands) &&
            w.Hands.Contains("TwoHanded"))
        {
            return true;
        }

        if (!string.IsNullOrEmpty(w.Range) &&
            !w.Range.Contains("Melee"))
        {
            return true;
        }

        return false;
    }

    private void IncreaseStat(string key)
    {
        if (availablePoints < 5)
            return;

        var baseVal = baseStats.ContainsKey(key)
            ? baseStats[key]
            : 0;

        var cur = currentStats.ContainsKey(key)
            ? currentStats[key]
            : baseVal;

        // Max +20 from base
        if (cur >= baseVal + 20)
            return;

        currentStats[key] = cur + 5;
        availablePoints -= 5;
    }

    private void DecreaseStat(string key)
    {
        if (!baseStats.ContainsKey(key))
            return;

        var baseVal = baseStats[key];
        var minVal = baseVal + 5;

        var cur = currentStats.ContainsKey(key)
            ? currentStats[key]
            : baseVal;

        if (cur <= minVal)
            return;

        currentStats[key] = cur - 5;
        availablePoints += 5;
    }

    private void Submit()
    {
        message =
            $"Created character: " +
            $"Location={selectedLocation}, " +
            $"Race={selectedRace}, " +
            $"Background={selectedBackground}, " +
            $"Trade={selectedTrade}, " +
            $"Motivation={selectedMotivation}, " +
            $"Features=[{feature1},{feature2},{feature3},{feature4}], " +
            $"Aristocrat Skills=[{selectedBackgroundExtraSkill1},{selectedBackgroundExtraSkill2}]";
    }

    private bool CanSave()
    {
        return
            !string.IsNullOrWhiteSpace(characterName) &&
            !string.IsNullOrWhiteSpace(selectedLocation) &&
            !string.IsNullOrWhiteSpace(selectedRace);
    }

    private async Task SaveCharacter()
    {
        if (!CanSave())
        {
            saveMessage =
                "Provide Name, Location and Race before saving.";

            return;
        }

        var dto = new ClientCharacterDto
        {
            Name = characterName,
            PowerLevel = selectedPowerLevel?.Name,
            Location = selectedLocation,
            Race = selectedRace,
            Background = selectedBackground,
            Trade = selectedTrade,
            Motivation = selectedMotivation,

            Features = new List<string>
        {
            feature1,
            feature2,
            feature3,
            feature4
        }
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList(),

            Armor = selectedArmor,
            MainWeapon = selectedMainWeapon,
            OffWeapon = selectedOffWeapon,

            CurrentStats = currentStats,
            AvailablePoints = availablePoints,

            // These properties are included in the client DTO.
            // If the server DTO supports them, they will also be persisted.
            BackgroundExtraSkill1 = IsAristocratBackground
                ? selectedBackgroundExtraSkill1
                : null,

            BackgroundExtraSkill2 = IsAristocratBackground
                ? selectedBackgroundExtraSkill2
                : null
        };

        try
        {
            var res = await Http.PostAsJsonAsync(
                "api/characters",
                dto);

            if (res.IsSuccessStatusCode)
            {
                try
                {
                    using var stream =
                        await res.Content.ReadAsStreamAsync();

                    using var doc =
                        await System.Text.Json.JsonDocument.ParseAsync(stream);

                    if (doc.RootElement.TryGetProperty(
                        "path",
                        out var pathProp))
                    {
                        saveMessage =
                            $"Saved: {pathProp.GetString()}";
                    }
                    else if (doc.RootElement.TryGetProperty(
                        "file",
                        out var fileProp))
                    {
                        saveMessage =
                            $"Saved: {fileProp.GetString()}";
                    }
                    else
                    {
                        saveMessage = "Saved.";
                    }
                }
                catch
                {
                    saveMessage = "Saved.";
                }

                await LoadSavedFiles();
            }
            else
            {
                saveMessage =
                    $"Save failed: {res.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            saveMessage =
                "Save error: " + ex.Message;
        }
    }

    private void OnSpellToggled(
        string spellName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value?.ToString() == "true" ||
            e.Value?.ToString() == "on";

        if (isChecked)
        {
            if (xpPool >= xpCost)
            {
                xpPool -= xpCost;
                learnedSpells.Add(spellName);
            }
        }
        else
        {
            // Uncheck -> refund
            if (learnedSpells.Contains(spellName))
            {
                xpPool += xpCost;
                learnedSpells.Remove(spellName);
            }
        }
    }

    private void AddXP()
    {
        xpPool += 50;
    }

    private void OnBackgroundSelected(ChangeEventArgs e)
    {
        // IMPORTANT: assign even when the user selects the blank option.
        // This allows the Aristocrat dropdowns to be cleared properly.
        selectedBackground = e.Value?.ToString();

        // If we are no longer Aristocrat, clear the two extra skills.
        if (!IsAristocratBackground)
        {
            selectedBackgroundExtraSkill1 = null;
            selectedBackgroundExtraSkill2 = null;
        }

        ReapplyAllBonusesSkillsTalentsTraits();
    }

    private void OnBackgroundExtraSkill1Changed(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();

        if (string.IsNullOrEmpty(name))
        {
            selectedBackgroundExtraSkill1 = null;
        }
        else
        {
            // Do not allow both dropdowns to select the same skill.
            if (name == selectedBackgroundExtraSkill2)
            {
                selectedBackgroundExtraSkill1 = null;
            }
            else
            {
                selectedBackgroundExtraSkill1 = name;
            }
        }

        ReapplyAllBonusesSkillsTalentsTraits();
    }

    private void OnBackgroundExtraSkill2Changed(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();

        if (string.IsNullOrEmpty(name))
        {
            selectedBackgroundExtraSkill2 = null;
        }
        else
        {
            // Do not allow both dropdowns to select the same skill.
            if (name == selectedBackgroundExtraSkill1)
            {
                selectedBackgroundExtraSkill2 = null;
            }
            else
            {
                selectedBackgroundExtraSkill2 = name;
            }
        }

        ReapplyAllBonusesSkillsTalentsTraits();
    }

    private List<SkillOption> GetAvailableAristocratSkills(int dropdownNumber)
    {
        var backgroundSkills =
            backgrounds
                .FirstOrDefault(x => x.Name == selectedBackground)?
                .Skills
                ?? new List<string>();

        return aristocratSkillOptions
            .Where(skill =>
                // Don't offer a skill already granted by the background.
                !backgroundSkills.Contains(
                    skill.Name,
                    StringComparer.OrdinalIgnoreCase))

            .Where(skill =>
                // Dropdown 1 excludes the current selection of dropdown 2.
                // Dropdown 2 excludes the current selection of dropdown 1.
                dropdownNumber == 1
                    ? skill.Name != selectedBackgroundExtraSkill2
                    : skill.Name != selectedBackgroundExtraSkill1)

            .ToList();
    }

