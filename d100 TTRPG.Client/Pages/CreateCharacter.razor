    private async Task LoadCharacter()
    {
        if (string.IsNullOrEmpty(selectedSavedFile))
            return;

        try
        {
            var dto =
                await Http.GetFromJsonAsync<ClientCharacterDto>(
                    $"api/characters/{selectedSavedFile}");

            if (dto != null)
            {
                characterName = dto.Name;

                selectedPowerLevel =
                    powerLevels.FirstOrDefault(
                        p => p.Name == dto.PowerLevel)
                    ?? selectedPowerLevel;

                selectedLocation = dto.Location;

                var loc =
                    locations.FirstOrDefault(
                        l => l.Name == selectedLocation);

                raceOptions =
                    loc?.Races ?? raceOptions;

                selectedRace = dto.Race;

                // Populate base stats from race definition
                var raceDef =
                    races.FirstOrDefault(
                        x => x.Name == selectedRace);

                if (raceDef != null)
                {
                    baseStats =
                        new Dictionary<string, int>
                        {
                            ["MSK"] = raceDef.MSK,
                            ["RSK"] = raceDef.RSK,
                            ["STR"] = raceDef.STR,
                            ["AGI"] = raceDef.AGI,
                            ["CON"] = raceDef.CON,
                            ["INT"] = raceDef.INT,
                            ["PER"] = raceDef.PER,
                            ["WPR"] = raceDef.WPR,
                            ["CHA"] = raceDef.CHA
                        };
                }

                selectedBackground = dto.Background;
                selectedTrade = dto.Trade;
                selectedMotivation = dto.Motivation;

                // Restore Aristocrat extra skills if the server supports them.
                if (IsAristocratBackground)
                {
                    selectedBackgroundExtraSkill1 =
                        dto.BackgroundExtraSkill1;

                    selectedBackgroundExtraSkill2 =
                        dto.BackgroundExtraSkill2;
                }
                else
                {
                    selectedBackgroundExtraSkill1 = null;
                    selectedBackgroundExtraSkill2 = null;
                }

                feature1 =
                    dto.Features != null &&
                    dto.Features.Count > 0
                        ? dto.Features[0]
                        : null;

                feature2 =
                    dto.Features != null &&
                    dto.Features.Count > 1
                        ? dto.Features[1]
                        : null;

                feature3 =
                    dto.Features != null &&
                    dto.Features.Count > 2
                        ? dto.Features[2]
                        : null;

                feature4 =
                    dto.Features != null &&
                    dto.Features.Count > 3
                        ? dto.Features[3]
                        : null;

                selectedArmor = dto.Armor;
                selectedMainWeapon = dto.MainWeapon;
                selectedOffWeapon = dto.OffWeapon;

                // Restore current stats
                if (dto.CurrentStats != null &&
                    dto.CurrentStats.Count > 0)
                {
                    currentStats =
                        new Dictionary<string, int>(
                            dto.CurrentStats);
                }
                else if (baseStats != null &&
                         baseStats.Any())
                {
                    currentStats =
                        baseStats.ToDictionary(
                            kv => kv.Key,
                            kv => kv.Value + 5);
                }

                // Restore available points
                availablePoints =
                    dto.AvailablePoints;

                // Ensure allowed features reflect selected power level
                if (selectedPowerLevel != null)
                {
                    allowedFeatures =
                        selectedPowerLevel.Features;
                }

                saveMessage = "Loaded.";

                // Re-apply all effects
                ReapplyAllBonusesSkillsTalentsTraits();
            }
        }
        catch (Exception ex)
        {
            saveMessage =
                "Load error: " + ex.Message;
        }
    }

