@page "/armor"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Armor</PageTitle>

<h1>Armor</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>ArmorPoints</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in items)
            {
                <tr>
                    <td>@a.Name</td>
                    <td>@a.ArmorPoints</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ArmorDto> items = new();
    private bool loaded = false;
    private string? saveMessage = "Loading armor...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            items = await Http.GetFromJsonAsync<List<ArmorDto>>("api/armor") ?? new List<ArmorDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load armor: {ex.Message}";

            loaded = true;
        }
        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class ArmorDto { public string? Name { get; set; } public object? ArmorPoints { get; set; } }
}
