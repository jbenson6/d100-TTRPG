@page "/motivations"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Motivations</PageTitle>

<h1>Motivations</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Skills</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in items)
            {
                var skills = "";
                <tr>
                    <td>@m.Name</td>
                    @if (m.Skills != null)
                    {
                        @foreach (var s in m.Skills)
                        {
                            if (m.Skills.IndexOf(s) != m.Skills.Count - 1)
                                skills += s + ", ";
                            else
                                skills += s;
                        }
                    }
                    <td> @skills </td>
                    <td>@m.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SimpleDto> items = new();
    private bool loaded = false;
    private string? saveMessage = "Loading motivations...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            items = await Http.GetFromJsonAsync<List<SimpleDto>>("api/motivations") ?? new List<SimpleDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load motivations: {ex.Message}";

            loaded = true;
        }
        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class SimpleDto
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public List<string>? Skills { get; set; }
    }
}
