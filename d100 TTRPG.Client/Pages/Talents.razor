@page "/talents"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Talents</PageTitle>

<h1>Talents</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Tier</th>
                <th>Combat</th>
                <th>XP</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in items)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.Tier</td>
                    <td>@(t.Combat ? "Yes" : "No")</td>
                    <td>@t.XpCost</td>
                    <td>@t.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TalentDto> items = new();
    private bool loaded = false;
    private string? saveMessage = "Loading talents...";


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            items = await Http.GetFromJsonAsync<List<TalentDto>>("api/talents") ?? new List<TalentDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load talents: {ex.Message}";

            loaded = true;
        }
        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class TalentDto { public string? Name { get; set; } public int Tier { get; set; } public bool Combat { get; set; } public int XpCost { get; set; } public string? Description { get; set; } }
}
