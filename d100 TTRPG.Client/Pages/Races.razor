@page "/races"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Races</PageTitle>

<h1>Races</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Race Bonuses</th>
                <th>Wounds</th>
                <th>MSK</th>
                <th>RSK</th>
                <th>STR</th>
                <th>AGI</th>
                <th>CON</th>
                <th>INT</th>
                <th>PER</th>
                <th>WPR</th>
                <th>CHA</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in items)
            {
                var bonuses = "";

                var skills = "Skills: ";

                var languages = "Languages: ";

                var talents = "Talents: ";

                var traits = "Traits: ";

                var features = "Features: ";
                <tr>
                    <td>@r.Name</td>
                    @if (r.Skills != null && r.Skills.Count > 0)
                    {
                        @foreach (var s in r.Skills)
                        {
                            if (r.Skills.IndexOf(s) != r.Skills.Count - 1)
                                skills += s + ", ";
                            else
                                skills += s;
                        }
                        bonuses += skills + "\n";
                    }
                    @if (r.Languages != null && r.Languages.Count > 0)
                    {
                        @foreach (var s in r.Languages)
                        {
                            if (r.Languages.IndexOf(s) != r.Languages.Count - 1)
                                languages += s + ", ";
                            else
                                languages += s;
                        }
                        bonuses += languages + "\n";
                    }
                    @if (r.Talents != null && r.Talents.Count > 0)
                    {
                        @foreach (var s in r.Talents)
                        {
                            if (r.Talents.IndexOf(s) != r.Talents.Count - 1)
                                talents += s + ", ";
                            else
                                talents += s;
                        }
                        bonuses += talents + "\n";
                    }
                    @if (r.Traits != null && r.Traits.Count > 0)
                    {
                        @foreach (var s in r.Traits)
                        {
                            if (r.Traits.IndexOf(s) != r.Traits.Count - 1)
                                traits += s + ", ";
                            else
                                traits += s;
                        }
                        bonuses += traits + "\n";
                    }
                    @if (r.Features != null && r.Features.Count > 0)
                    {
                        @foreach (var s in r.Features)
                        {
                            if (r.Features.IndexOf(s) != r.Features.Count - 1)
                                features += s + ", ";
                            else
                                features += s;
                        }
                        bonuses += features + "\n";
                    }
                    <td style="white-space: pre-line;">@bonuses</td>
                    <td>@r.Wounds</td>
                    <td>@r.MSK</td>
                    <td>@r.RSK</td>
                    <td>@r.STR</td>
                    <td>@r.AGI</td>
                    <td>@r.CON</td>
                    <td>@r.INT</td>
                    <td>@r.PER</td>
                    <td>@r.WPR</td>
                    <td>@r.CHA</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RaceDto> items = new();
    private bool loaded = false;
    private string? saveMessage = "Loading races...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            items = await Http.GetFromJsonAsync<List<RaceDto>>("api/races") ?? new List<RaceDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load races: {ex.Message}";

            loaded = true;
        }
        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class RaceDto
    {
        public string? Name { get; set; }
        public int Wounds { get; set; }
        public int MSK { get; set; }
        public int RSK { get; set; }
        public int STR { get; set; }
        public int AGI { get; set; }
        public int CON { get; set; }
        public int INT { get; set; }
        public int PER { get; set; }
        public int WPR { get; set; }
        public int CHA { get; set; }

        public List<string>? Skills { get; set; }
        public List<string>? Languages { get; set; }
        public List<string>? Talents { get; set; }
        public List<string>? Traits { get; set; }
        public List<string>? Features { get; set; }

    }
}
