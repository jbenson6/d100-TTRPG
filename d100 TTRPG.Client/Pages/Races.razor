@page "/races"
@rendermode InteractiveAuto

@inject HttpClient Http

<PageTitle>Races</PageTitle>

<h1>Races</h1>

@if (!loaded)
{
    <p>Loading races...</p>
}
else if (items == null || !items.Any())
{
    <p>No races available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Wounds</th>
                <th>MSK</th>
                <th>RSK</th>
                <th>STR</th>
                <th>AGI</th>
                <th>CON</th>
                <th>INT</th>
                <th>PER</th>
                <th>WPR</th>
                <th>CHA</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in items)
            {
                <tr>
                    <td>@r.Name</td>
                    <td>@r.Wounds</td>
                    <td>@r.MSK</td>
                    <td>@r.RSK</td>
                    <td>@r.STR</td>
                    <td>@r.AGI</td>
                    <td>@r.CON</td>
                    <td>@r.INT</td>
                    <td>@r.PER</td>
                    <td>@r.WPR</td>
                    <td>@r.CHA</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RaceDto> items = new();
    private bool loaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        if (!OperatingSystem.IsBrowser())
        {
            loaded = true;
            return;
        }

        try
        {
            items = await Http.GetFromJsonAsync<List<RaceDto>>("api/races") ?? new List<RaceDto>();
        }
        catch
        {
            items = new List<RaceDto>();
        }

        loaded = true;
        StateHasChanged();
    }

    private class RaceDto
    {
        public string? Name { get; set; }
        public int Wounds { get; set; }
        public int MSK { get; set; }
        public int RSK { get; set; }
        public int STR { get; set; }
        public int AGI { get; set; }
        public int CON { get; set; }
        public int INT { get; set; }
        public int PER { get; set; }
        public int WPR { get; set; }
        public int CHA { get; set; }
    }
}
