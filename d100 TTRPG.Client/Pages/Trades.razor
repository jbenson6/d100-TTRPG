@page "/trades"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Trades</PageTitle>

<h1>Trades</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in trades)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TradeDto> trades = new();
    private bool loaded = false;
    private string? saveMessage = "Loading trades...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            trades = await Http.GetFromJsonAsync<List<TradeDto>>("api/trades") ?? new List<TradeDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load trades: {ex.Message}";

            loaded = true;
        }

        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class TradeDto
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
    }
}
