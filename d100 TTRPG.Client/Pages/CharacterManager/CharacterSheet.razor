    // =================================================
    // ARMOR PROFICIENCY
    // =================================================

    private int GetArmorProficiencyRank(
        string? proficiency)
    {
        if (string.IsNullOrWhiteSpace(proficiency))
            return 0;

        return proficiency.Trim()
            .ToLowerInvariant() switch
        {
            "none" => 0,
            "padded" => 1,
            "light" => 2,
            "medium" => 3,
            "heavy" => 4,
            "superheavy" => 5,
            _ => 0
        };
    }

    // =================================================
    // HIGHEST ARMOR PROFICIENCY
    // =================================================

    private int GetHighestArmorProficiencyRank()
    {
        var highest = 0;

        var selectedFeatures =
            new[]
            {
            feature1,
            feature2,
            feature3,
            feature4
            };

        foreach (var featureName in selectedFeatures)
        {
            if (string.IsNullOrEmpty(featureName))
                continue;

            var feature =
                features.FirstOrDefault(
                    f => f.Name == featureName);

            if (feature == null)
                continue;

            var rank =
                GetArmorProficiencyRank(
                    feature.Armor);

            if (rank > highest)
            {
                highest = rank;
            }
        }

        return highest;
    }

    // =================================================
    // HIGHEST ARMOR PROFICIENCY NAME
    // =================================================

    private string GetHighestArmorProficiencyName()
    {
        return GetHighestArmorProficiencyRank() switch
        {
            0 => "None",
            1 => "Padded",
            2 => "Light",
            3 => "Medium",
            4 => "Heavy",
            5 => "SuperHeavy",
            _ => "None"
        };
    }

    // =================================================
    // ARMOR RANK
    // =================================================

    private int GetArmorRank(
        string? armorName)
    {
        return GetArmorProficiencyRank(
            armorName);
    }

    // =================================================
    // AVAILABLE ARMOR
    // =================================================

    private IEnumerable<ArmorDto> GetAvailableArmors()
    {
        var highestProficiency =
            GetHighestArmorProficiencyRank();

        if (highestProficiency <= 0)
        {
            return Enumerable.Empty<ArmorDto>();
        }

        return armors
            .Where(a =>
            {
                var armorRank =
                    GetArmorRank(a.Name);

                return armorRank > 0 &&
                       armorRank <= highestProficiency;
            })
            .OrderBy(a => GetArmorRank(a.Name))
            .ThenBy(a => a.ArmorPoints);
    }

    // =================================================
    // VALIDATE SELECTED ARMOR
    // =================================================

    private void ValidateSelectedArmor()
    {
        if (string.IsNullOrEmpty(selectedArmor))
            return;

        var availableArmorNames =
            GetAvailableArmors()
                .Select(a => a.Name)
                .Where(n => !string.IsNullOrEmpty(n))
                .ToHashSet();

        if (!availableArmorNames.Contains(
            selectedArmor))
        {
            selectedArmor = null;
        }
    }

    // =================================================
    // ADD TRAITS
    // =================================================

    private void AddTrait(string? trait)
    {
        if (string.IsNullOrWhiteSpace(trait))
            return;

        if (!traits.Contains(trait))
        {
            traits.Add(trait);
        }
    }

    // =================================================
    // ADD WEAPON TRAITS
    // =================================================

    private void AddWeaponTraits(string? weaponName)
    {
        if (string.IsNullOrWhiteSpace(weaponName))
            return;

        var weapon =
            weapons.FirstOrDefault(
                w => w.Name == weaponName);

        if (weapon == null)
            return;

        foreach (var trait in weapon.Traits)
        {
            AddTrait(trait);
        }
    }

    // =================================================
    // REAPPLY ALL BONUSES / SKILLS / TALENTS / TRAITS
    // =================================================

    private void ReapplyAllBonusesSkillsTalentsTraits()
    {
        featureBonuses.Clear();
        skillCounts.Clear();
        talents.Clear();
        traits.Clear();

        totalFeatureMP = 0;
        totalFeatureWounds = 0;

        // -------------------------------------------------
        // RACE
        // -------------------------------------------------

        var race =
            races.FirstOrDefault(
                r => r.Name == selectedRace);

        if (race != null)
        {
            foreach (var skill in race.Skills)
            {
                AddSkillCount(
                    skillCounts,
                    skill,
                    1);
            }

            foreach (var talent in race.Talents)
            {
                if (!string.IsNullOrWhiteSpace(talent))
                {
                    talents.Add(talent);
                }
            }

            foreach (var trait in race.Traits)
            {
                AddTrait(trait);
            }
        }

        // -------------------------------------------------
        // FEATURES
        // -------------------------------------------------

        var selectedFeatures =
            new[]
            {
            feature1,
            feature2,
            feature3,
            feature4
            };

        foreach (var fname in selectedFeatures)
        {
            if (string.IsNullOrEmpty(fname))
                continue;

            var f =
                features.FirstOrDefault(
                    x => x.Name == fname);

            if (f == null)
                continue;

            foreach (var cb in f.CharBonuses)
            {
                featureBonuses.TryGetValue(
                    cb,
                    out var cur);

                featureBonuses[cb] =
                    cur + 5;
            }

            foreach (var sk in f.Skills)
            {
                skillCounts.TryGetValue(
                    sk,
                    out var sc);

                skillCounts[sk] =
                    sc + 1;
            }

            foreach (var talent in f.Talents)
            {
                if (!string.IsNullOrWhiteSpace(talent))
                {
                    talents.Add(talent);
                }
            }

            totalFeatureMP += f.MP;
            totalFeatureWounds += f.Wounds;
        }

        // -------------------------------------------------
        // BACKGROUND
        // -------------------------------------------------

        if (!string.IsNullOrEmpty(selectedBackground))
        {
            var b =
                backgrounds.FirstOrDefault(
                    x => x.Name == selectedBackground);

            if (b != null &&
                b.Skills != null)
            {
                foreach (var sk in b.Skills)
                {
                    skillCounts.TryGetValue(
                        sk,
                        out var sc);

                    skillCounts[sk] =
                        sc + 1;
                }
            }

            if (b != null &&
                !string.IsNullOrWhiteSpace(b.Talent))
            {
                talents.Add(b.Talent);
            }

            if (selectedBackground == "Aristocrat")
            {
                AddSkillCount(
                    skillCounts,
                    selectedAristocratSkill1,
                    1);

                AddSkillCount(
                    skillCounts,
                    selectedAristocratSkill2,
                    1);
            }
        }

        // -------------------------------------------------
        // TRADE
        // -------------------------------------------------

        if (!string.IsNullOrEmpty(selectedTrade))
        {
            var t =
                trades.FirstOrDefault(
                    x => x.Name == selectedTrade);

            if (t != null &&
                t.Skills != null)
            {
                foreach (var sk in t.Skills)
                {
                    skillCounts.TryGetValue(
                        sk,
                        out var sc);

                    skillCounts[sk] =
                        sc + 1;
                }
            }

            if (t != null &&
                !string.IsNullOrWhiteSpace(t.Talent))
            {
                talents.Add(t.Talent);
            }

            if (selectedTrade == "Scholar")
            {
                AddSkillCount(
                    skillCounts,
                    selectedScholarSkill,
                    2);
            }

            if (selectedTrade == "Artisan")
            {
                AddSkillCount(
                    skillCounts,
                    selectedArtisanSkill,
                    1);
            }
        }

        // -------------------------------------------------
        // MOTIVATION
        // -------------------------------------------------

        if (!string.IsNullOrEmpty(selectedMotivation))
        {
            var m =
                motivations.FirstOrDefault(
                    x => x.Name == selectedMotivation);

            if (m != null &&
                m.Skills != null)
            {
                foreach (var sk in m.Skills)
                {
                    skillCounts.TryGetValue(
                        sk,
                        out var sc);

                    skillCounts[sk] =
                        sc + 1;
                }
            }

            if (m != null &&
                !string.IsNullOrWhiteSpace(m.Talent))
            {
                talents.Add(m.Talent);
            }

            if (selectedMotivation == "Pleasure")
            {
                AddSkillCount(
                    skillCounts,
                    selectedPleasureSkill,
                    1);
            }
        }

        // -------------------------------------------------
        // ARMOR
        // -------------------------------------------------

        ValidateSelectedArmor();

        // -------------------------------------------------
        // WEAPON TRAITS
        // -------------------------------------------------

        AddWeaponTraits(selectedMainWeapon);
        AddWeaponTraits(selectedOffWeapon);

        // -------------------------------------------------
        // SPELLS
        // -------------------------------------------------

        RebuildLearnedSpells();
    }

    // =================================================
    // ADD SKILL COUNT
    // =================================================

    private void AddSkillCount(
        Dictionary<string, int> counts,
        string? skill,
        int amount)
    {
        if (string.IsNullOrEmpty(skill))
            return;

        counts.TryGetValue(
            skill,
            out var current);

        counts[skill] =
            current + amount;
    }

