    // =================================================
    // LOAD CHARACTER
    // =================================================

    private async Task LoadCharacter()
    {
        if (string.IsNullOrEmpty(selectedSavedFile))
            return;

        try
        {
            var dto =
                await Http.GetFromJsonAsync<ClientCharacterDto>(
                    $"api/characters/{selectedSavedFile}");

            if (dto != null)
            {
                characterName =
                    dto.Name;

                selectedPowerLevel =
                    powerLevels.FirstOrDefault(
                        p => p.Name == dto.PowerLevel)
                    ?? selectedPowerLevel;

                selectedLocation =
                    dto.Location;

                var loc =
                    locations.FirstOrDefault(
                        l => l.Name == selectedLocation);

                raceOptions =
                    loc?.Races ?? raceOptions;

                selectedRace =
                    dto.Race;

                var raceDef =
                    races.FirstOrDefault(
                        x => x.Name == selectedRace);

                if (raceDef != null)
                {
                    baseStats =
                        new Dictionary<string, int>
                        {
                            ["MSK"] = raceDef.MSK,
                            ["RSK"] = raceDef.RSK,
                            ["STR"] = raceDef.STR,
                            ["AGI"] = raceDef.AGI,
                            ["CON"] = raceDef.CON,
                            ["INT"] = raceDef.INT,
                            ["PER"] = raceDef.PER,
                            ["WPR"] = raceDef.WPR,
                            ["CHA"] = raceDef.CHA
                        };
                }
                else
                {
                    baseStats.Clear();
                }

                selectedBackground =
                    dto.Background;

                selectedTrade =
                    dto.Trade;

                selectedMotivation =
                    dto.Motivation;

                selectedAristocratSkill1 =
                    dto.AristocratSkill1;

                selectedAristocratSkill2 =
                    dto.AristocratSkill2;

                selectedScholarSkill =
                    dto.ScholarSkill;

                selectedArtisanSkill =
                    dto.ArtisanSkill;

                selectedPleasureSkill =
                    dto.PleasureSkill;

                if (selectedBackground != "Aristocrat")
                {
                    selectedAristocratSkill1 = null;
                    selectedAristocratSkill2 = null;
                }
                else
                {
                    //will not be more than 2
                    selectedAristocratSkill1 = dto.BackgroundSkillChoices[0];
                    selectedAristocratSkill2 = dto.BackgroundSkillChoices[1];
                }

                if (selectedTrade != "Scholar")
                {
                    selectedScholarSkill = null;
                }
                else
                {
                    //will not be more than 1
                    selectedScholarSkill = dto.TradeSkillChoices[0];
                }

                if (selectedTrade != "Artisan")
                {
                    selectedArtisanSkill = null;
                }
                else
                {
                    //will not be more than 1
                    selectedArtisanSkill = dto.TradeSkillChoices[0];
                }

                if (selectedMotivation != "Pleasure")
                {
                    selectedPleasureSkill = null;
                }
                else
                {
                    //will not be more than 1
                    selectedPleasureSkill = dto.MotivationSkillChoices[0];
                }
                featuresSelected.Clear();

                feature1 =
                    dto.Features != null &&
                    dto.Features.Count > 0
                        ? dto.Features[0]
                        : null;
                if (feature1 != null)
                    featuresSelected.Add(1, feature1);

                feature2 =
                    dto.Features != null &&
                    dto.Features.Count > 1
                        ? dto.Features[1]
                        : null;
                if (feature2 != null)
                    featuresSelected.Add(2, feature2);

                feature3 =
                    dto.Features != null &&
                    dto.Features.Count > 2
                        ? dto.Features[2]
                        : null;
                if (feature3 != null)
                    featuresSelected.Add(3, feature3);

                feature4 =
                    dto.Features != null &&
                    dto.Features.Count > 3
                        ? dto.Features[3]
                        : null;
                if (feature4 != null)
                    featuresSelected.Add(4, feature4);

                selectedArmor =
                    dto.Armor;

                selectedMainWeapon =
                    dto.MainWeapon;

                selectedOffWeapon =
                    dto.OffWeapon;

                equippedWeapons = GetEquippedWeapons();

                if (dto.CurrentStats != null &&
                    dto.CurrentStats.Count > 0)
                {
                    currentStats =
                        new Dictionary<string, int>(
                            dto.CurrentStats);
                }
                else if (baseStats.Any())
                {
                    currentStats =
                        baseStats.ToDictionary(
                            kv => kv.Key,
                            kv => kv.Value + 5);
                }
                else
                {
                    currentStats.Clear();
                }

                availablePoints =
                    dto.AvailablePoints;

                // -------------------------------------------------
                // RESTORE XP
                // -------------------------------------------------

                xpPool =
                    Math.Max(
                        0,
                        dto.XpPool);

                xpSpent =
                    Math.Max(
                        0,
                        dto.XpSpent);


                // -------------------------------------------------
                // RESTORE PURCHASED SPELLS
                // -------------------------------------------------

                purchasedSpells =
                    dto.PurchasedSpells != null
                        ? new HashSet<string>(
                            dto.PurchasedSpells
                                .Where(s =>
                                    !string.IsNullOrWhiteSpace(s)))
                        : new HashSet<string>();

                // -------------------------------------------------
                // RESTORE LEARNED SPELLS
                // -------------------------------------------------

                learnedSpells =
                    dto.LearnedSpells != null
                        ? new HashSet<string>(
                            dto.LearnedSpells
                                .Where(s =>
                                    !string.IsNullOrWhiteSpace(s)))
                        : new HashSet<string>();

                if (selectedPowerLevel != null)
                {
                    allowedFeatures =
                        selectedPowerLevel.Features;
                }

                saveMessage =
                    "Loaded.";

                loF = dto.LoF;

                damage = dto.Damage;

                // Rebuild derived data from the selections while
                // preserving the purchased spell set.
                ReapplyAllBonusesSkillsTalentsTraits();
            }
            await OnCharacterLoaded.InvokeAsync(dto);
        }
        catch (Exception ex)
        {
            saveMessage =
                "Load error: " + ex.Message;
        }
    }

