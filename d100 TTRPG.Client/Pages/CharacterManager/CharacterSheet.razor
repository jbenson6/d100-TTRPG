    // =================================================
    // OFFHAND DISABLED
    // =================================================

    private bool IsOffhandDisabled()
    {
        if (string.IsNullOrEmpty(selectedMainWeapon))
            return false;

        var w =
            weapons.FirstOrDefault(
                x => x.Name == selectedMainWeapon);

        if (w == null)
            return false;

        if (!string.IsNullOrEmpty(w.Hands) &&
            w.Hands.Contains("TwoHanded"))
        {
            return true;
        }

        if (!string.IsNullOrEmpty(w.Range) &&
            !w.Range.Contains("Melee"))
        {
            return true;
        }

        return false;
    }

    // =================================================
    // STAT INCREASE
    // =================================================

    private void IncreaseStat(string key)
    {
        if (availablePoints < 5)
            return;

        var baseVal =
            baseStats.ContainsKey(key)
                ? baseStats[key]
                : 0;

        var cur =
            currentStats.ContainsKey(key)
                ? currentStats[key]
                : baseVal;

        if (cur >= baseVal + 20)
            return;

        currentStats[key] =
            cur + 5;

        availablePoints -= 5;

        ReapplyAllBonusesSkillsTalentsTraits();
    }

    // =================================================
    // STAT DECREASE
    // =================================================

    private void DecreaseStat(string key)
    {
        if (!baseStats.ContainsKey(key))
            return;

        var baseVal =
            baseStats[key];

        var minVal =
            baseVal + 5;

        var cur =
            currentStats.ContainsKey(key)
                ? currentStats[key]
                : baseVal;

        if (cur <= minVal)
            return;

        currentStats[key] =
            cur - 5;

        availablePoints += 5;

        ReapplyAllBonusesSkillsTalentsTraits();
    }

