    // =================================================
    // SET SAVE PATH
    // =================================================

    private async Task SetSavePath()
    {
        if (string.IsNullOrWhiteSpace(customBasePath))
        {
            saveMessage =
                "Enter a base folder path before setting.";

            return;
        }

        try
        {
            var dto =
                new
                {
                    BasePath = customBasePath
                };

            var res =
                await Http.PostAsJsonAsync(
                    "api/characters/savepath",
                    dto);

            if (res.IsSuccessStatusCode)
            {
                var info =
                    await res.Content.ReadFromJsonAsync<
                        Dictionary<string, string>>();

                if (info != null &&
                    info.TryGetValue(
                        "folder",
                        out var folder))
                {
                    currentSaveFolder =
                        folder;

                    saveMessage =
                        $"Save folder set to: {folder}";
                }
                else
                {
                    saveMessage =
                        "Save path set.";
                }

                await LoadSavedFiles();
            }
            else
            {
                saveMessage =
                    $"Set save path failed: {res.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            saveMessage =
                "Set save path error: " + ex.Message;
        }
    }

    // =================================================
    // RESET SAVE PATH
    // =================================================

    private async Task ResetSavePath()
    {
        try
        {
            var res =
                await Http.DeleteAsync(
                    "api/characters/savepath");

            if (res.IsSuccessStatusCode)
            {
                var info =
                    await res.Content.ReadFromJsonAsync<
                        Dictionary<string, string>>();

                if (info != null &&
                    info.TryGetValue(
                        "folder",
                        out var folder))
                {
                    currentSaveFolder =
                        folder;

                    saveMessage =
                        $"Reset to default folder: {folder}";
                }
                else
                {
                    saveMessage =
                        "Reset to default.";
                }

                await LoadSavedFiles();
            }
            else
            {
                saveMessage =
                    $"Reset failed: {res.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            saveMessage =
                "Reset error: " + ex.Message;
        }
    }

