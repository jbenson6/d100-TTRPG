@inject HttpClient Http
@using d100_TTRPG.Shared.Data_Objects

<h1>Character Sheet</h1>

<div class="card p-3 mb-3">

    <h5>Load</h5>

    <div class="row g-2 align-items-center">
        <div class="col-auto">

            <select class="form-select"
                    style="min-width:240px"
                    @bind="selectedSavedFile">

                <option value="">
                    (Select saved file)
                </option>

                @foreach (var f in savedFiles)
                {
                    <option value="@f">
                        @f
                    </option>
                }

            </select>

        </div>

        <div class="col-auto">

            <button class="btn btn-secondary"
                    @onclick="LoadCharacter"
                    disabled="@(string.IsNullOrEmpty(selectedSavedFile))">
                Load
            </button>

        </div>
    </div>
</div>

<div class="card p-3">

    <div class="mb-3">

        <label class="form-label">Power Level</label>

        <select class="form-select" @onchange="OnPowerLevelChanged">

            <option value="">(Select a power level)</option>

            @foreach (var p in powerLevels)
            {
                <option value="@p.Name"
                        selected="@(selectedPowerLevel != null && p.Name == selectedPowerLevel.Name)">
                    @p.Name (@p.Points pts, @p.Features features)
                </option>
            }

        </select>

    </div>

    <div class="mb-3">

        <label class="form-label">Location</label>

        <select class="form-select" @onchange="OnLocationChanged">

            <option value="">(Select a location)</option>

            @foreach (var loc in locations)
            {
                <option value="@loc.Name"
                        selected="@(loc.Name == selectedLocation)">
                    @loc.Name
                </option>
            }

        </select>

    </div>

    <div class="mb-3">

        <label class="form-label">Race</label>

        <select class="form-select" @onchange="OnRaceChanged">

            <option value="">(Select a race)</option>

            @foreach (var r in raceOptions)
            {
                <option value="@r"
                        selected="@(r == selectedRace)">
                    @r
                </option>
            }

        </select>

    </div>

    <div class="mb-3">

        <label class="form-label">Character Name</label>

        <input class="form-control"
               @bind="characterName"
               placeholder="Character name (used for filename)" />

    </div>

    <div class="row">

        <div class="col-md-4 mb-3">

            <label class="form-label">Background</label>

            <select class="form-select"
                    @onchange="OnBackgroundSelected">

                <option value="">(Select background)</option>

                @foreach (var b in backgrounds)
                {
                    <option value="@b.Name"
                            selected="@(selectedBackground == b.Name)">
                        @b.Name
                    </option>
                }

            </select>

        </div>

        <div class="col-md-4 mb-3">

            <label class="form-label">Trade</label>

            <select class="form-select"
                    @onchange="OnTradeSelected">

                <option value="">(Select trade)</option>

                @foreach (var t in trades)
                {
                    <option value="@t.Name"
                            selected="@(selectedTrade == t.Name)">
                        @t.Name
                    </option>
                }

            </select>

        </div>

        <div class="col-md-4 mb-3">

            <label class="form-label">Motivation</label>

            <select class="form-select"
                    @onchange="OnMotivationSelected">

                <option value="">(Select motivation)</option>

                @foreach (var m in motivations)
                {
                    <option value="@m.Name"
                            selected="@(selectedMotivation == m.Name)">
                        @m.Name
                    </option>
                }

            </select>

        </div>

    </div>

    @if (selectedBackground == "Aristocrat")
    {
        <div class="card p-3 mb-3 border-primary">

            <h6 class="text-primary">
                Aristocrat — Choose 2 Skills
            </h6>

            <div class="row">

                <div class="col-md-6 mb-2">

                    <label class="form-label">
                        Skill Choice 1
                    </label>

                    <select class="form-select"
                            @onchange="OnAristocratSkill1Changed">

                        <option value="">(Select skill)</option>

                        @foreach (var skill in aristocratSkills)
                        {
                            <option value="@skill.Key"
                                    selected="@(selectedAristocratSkill1 == skill.Key)">
                                @skill.Key
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-6 mb-2">

                    <label class="form-label">
                        Skill Choice 2
                    </label>

                    <select class="form-select"
                            @onchange="OnAristocratSkill2Changed">

                        <option value="">(Select skill)</option>

                        @foreach (var skill in aristocratSkills)
                        {
                            <option value="@skill.Key"
                                    disabled="@(skill.Key == selectedAristocratSkill1)"
                                    selected="@(selectedAristocratSkill2 == skill.Key)">
                                @skill.Key
                            </option>
                        }

                    </select>

                </div>

            </div>

            <div class="form-text">
                Each selected skill receives 1 additional skill count.
            </div>

        </div>
    }

    @if (selectedTrade == "Scholar")
    {
        <div class="card p-3 mb-3 border-success">

            <h6 class="text-success">
                Scholar — Choose 1 Skill
            </h6>

            <div class="mb-2">

                <label class="form-label">
                    Scholar Skill
                </label>

                <select class="form-select"
                        @onchange="OnScholarSkillChanged">

                    <option value="">(Select skill)</option>

                    @foreach (var skill in scholarSkills)
                    {
                        <option value="@skill.Key"
                                selected="@(selectedScholarSkill == skill.Key)">
                            @skill.Key
                        </option>
                    }

                </select>

            </div>

            <div class="form-text">
                The selected skill receives 2 additional skill counts.
            </div>

        </div>
    }

    @if (selectedTrade == "Artisan")
    {
        <div class="card p-3 mb-3 border-success">

            <h6 class="text-success">
                Artisan — Choose 1 Skill
            </h6>

            <div class="mb-2">

                <label class="form-label">
                    Artisan Skill
                </label>

                <select class="form-select"
                        @onchange="OnArtisanSkillChanged">

                    <option value="">(Select skill)</option>

                    @foreach (var skill in artisanSkills)
                    {
                        <option value="@skill.Key"
                                selected="@(selectedArtisanSkill == skill.Key)">
                            @skill.Key
                        </option>
                    }

                </select>

            </div>

            <div class="form-text">
                The selected skill receives 1 additional skill count.
            </div>

        </div>
    }

    @if (selectedMotivation == "Pleasure")
    {
        <div class="card p-3 mb-3 border-warning">

            <h6 class="text-warning">
                Pleasure — Choose 1 Skill
            </h6>

            <div class="mb-2">

                <label class="form-label">
                    Pleasure Skill
                </label>

                <select class="form-select"
                        @onchange="OnPleasureSkillChanged">

                    <option value="">(Select skill)</option>

                    @foreach (var skill in pleasureSkills)
                    {
                        <option value="@skill.Key"
                                selected="@(selectedPleasureSkill == skill.Key)">
                            @skill.Key
                        </option>
                    }

                </select>

            </div>

            <div class="form-text">
                The selected skill receives 1 additional skill count.
            </div>

        </div>
    }

    <div class="row">

        <div class="col-md-4 mb-3">

            <label class="form-label">
                Feature 1
            </label>

            <select class="form-select"
                    @onchange="e => OnFeatureSelected(1, e)">

                <option value="">(Select feature)</option>

                @foreach (var f in features)
                {
                    <option value="@f.Name"
                            selected="@(feature1 == f.Name)">
                        @f.Name
                    </option>
                }

            </select>

            @if (featureWarnings.ContainsKey(1))
            {
                <div class="text-danger mt-1">
                    @featureWarnings[1]
                </div>
            }

        </div>

        <div class="col-md-4 mb-3">

            <label class="form-label">
                Feature 2
            </label>

            <select class="form-select"
                    @onchange="e => OnFeatureSelected(2, e)">

                <option value="">(Select feature)</option>

                @foreach (var f in features)
                {
                    <option value="@f.Name"
                            selected="@(feature2 == f.Name)">
                        @f.Name
                    </option>
                }

            </select>

            @if (featureWarnings.ContainsKey(2))
            {
                <div class="text-danger mt-1">
                    @featureWarnings[2]
                </div>
            }

        </div>

        @if (allowedFeatures >= 3)
        {
            <div class="col-md-4 mb-3">

                <label class="form-label">
                    Feature 3
                </label>

                <select class="form-select"
                        @onchange="e => OnFeatureSelected(3, e)">

                    <option value="">(Select feature)</option>

                    @foreach (var f in features)
                    {
                        <option value="@f.Name"
                                selected="@(feature3 == f.Name)">
                            @f.Name
                        </option>
                    }

                </select>

                @if (featureWarnings.ContainsKey(3))
                {
                    <div class="text-danger mt-1">
                        @featureWarnings[3]
                    </div>
                }

            </div>
        }

        @if (allowedFeatures >= 4)
        {
            <div class="col-md-4 mb-3">

                <label class="form-label">
                    Feature 4
                </label>

                <select class="form-select"
                        @onchange="e => OnFeatureSelected(4, e)">

                    <option value="">(Select feature)</option>

                    @foreach (var f in features)
                    {
                        <option value="@f.Name"
                                selected="@(feature4 == f.Name)">
                            @f.Name
                        </option>
                    }

                </select>

                @if (featureWarnings.ContainsKey(4))
                {
                    <div class="text-danger mt-1">
                        @featureWarnings[4]
                    </div>
                }

            </div>
        }

    </div>

    <div class="card p-3 mt-3 mb-3">

        <h5>Derived</h5>

        <div class="row">

            <div class="col-md-6">

                <div>
                    <strong>Level</strong>: @GetLevel()
                </div>

                <div>
                    <strong>Wounds</strong>: @GetTotalWounds()
                </div>

                <div>
                    <strong>MP</strong>: @GetTotalMP()
                </div>

                <div>
                    <strong>Armor Points</strong>: @GetArmorPoints()
                </div>

                <div>
                    <strong>LoF</strong>: @GetLevelsOfFatigue()
                </div>

                <div>
                    <strong>Damage</strong>: @GetDamage()
                </div>


                <h6 class="mt-3">Features</h6>

                @if (featuresSelected.Any())
                {
                    <div class="sheet-description-list">

                        @foreach (var feature in featuresSelected.OrderBy(x => x.Key))
                        {
                            var description = GetFeatureDescription(feature.Value);

                            <div class="sheet-description-item">
                                <label class="description-hover"
                                       data-description="@description">
                                    @feature.Value
                                </label>
                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-muted">
                        No features.
                    </div>
                }


                <h6>Skills</h6>

                @if (skillCounts.Any())
                {
                    <div class="sheet-description-list">

                        @foreach (var kv in skillCounts.OrderBy(x => x.Key))
                        {
                            var description = GetSkillDescription(kv.Key);

                            <div class="sheet-description-item">
                                <label class="description-hover"
                                       data-description="@description">
                                    @kv.Key - @GetSkillRank(kv.Value)
                                </label>
                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-muted">
                        No skills.
                    </div>
                }


                <h6 class="mt-3">Talents</h6>

                @if (talents.Any())
                {
                    <div class="sheet-description-list">

                        @foreach (var talent in talents.OrderBy(x => x))
                        {
                            var description = GetTalentDescription(talent);

                            <div class="sheet-description-item">
                                <label class="description-hover"
                                       data-description="@description">
                                    @talent
                                </label>
                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-muted">
                        No talents.
                    </div>
                }


                <h6 class="mt-3">Traits</h6>

                @if (traits.Any())
                {
                    <div class="sheet-description-list">

                        @foreach (var trait in traits.OrderBy(x => x))
                        {
                            var description = GetTraitDescription(trait);

                            <div class="sheet-description-item">
                                <label class="description-hover"
                                       data-description="@description">
                                    @trait
                                </label>
                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-muted">
                        No traits.
                    </div>
                }


                <h6>Learned Spells</h6>

                @if (learnedSpells.Any())
                {
                    <div class="sheet-description-list">

                        @foreach (var ls in learnedSpells.OrderBy(x => x))
                        {
                            var purchased = purchasedSpells.Contains(ls);
                            var description = GetSpellDescription(ls);

                            <div class="sheet-description-item">

                                <label class="description-hover"
                                       data-description="@description">

                                    @ls

                                    @if (purchased)
                                    {
                                        <span class="text-muted">
                                            (purchased)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">
                                            (granted)
                                        </span>
                                    }

                                </label>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-muted">
                        No learned spells.
                    </div>
                }

            </div>

            <div class="col-md-6">

                <div class="card p-3 mb-3">

                    <h5>Character Sheet</h5>

                    <div class="mb-2">
                        Points available:
                        <strong>@availablePoints</strong>
                    </div>

                    @if (baseStats != null && baseStats.Any())
                    {
                        <table class="table table-sm">

                            <thead>
                                <tr>
                                    <th>Stat</th>
                                    <th>Value</th>
                                    <th>Feat</th>
                                    <th>Bonus</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var key in new[]
                                {
                                    "MSK",
                                    "RSK",
                                    "STR",
                                    "AGI",
                                    "CON",
                                    "INT",
                                    "PER",
                                    "WPR",
                                    "CHA"
                                })
                                {
                                    var baseVal =
                                        baseStats.ContainsKey(key)
                                            ? baseStats[key]
                                            : 0;

                                    var curVal =
                                        currentStats.ContainsKey(key)
                                            ? currentStats[key]
                                            : baseVal;

                                    featureBonuses.TryGetValue(
                                        key,
                                        out var fb);

                                    var effective =
                                        curVal + fb;

                                    var charBonus =
                                        effective / 10;

                                    <tr>

                                        <td>@key</td>

                                        <td>
                                            @effective

                                            @if (fb > 0)
                                            {
                                                <small class="text-success">
                                                    (+@fb)
                                                </small>
                                            }
                                        </td>

                                        <td>@fb</td>

                                        <td>@charBonus</td>

                                        <td>

                                            <button class="btn btn-sm btn-secondary me-1"
                                                    @onclick="() => DecreaseStat(key)"
                                                    disabled="@(curVal <= baseVal + 5)">
                                                -
                                            </button>

                                            <button class="btn btn-sm btn-secondary"
                                                    @onclick="() => IncreaseStat(key)"
                                                    disabled="@(availablePoints < 5 || curVal >= baseVal + 20)">
                                                +
                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            Select a race to populate base statistics.
                        </p>
                    }

                </div>


                <div class="card p-3 mb-3">

                    <h5>Equipment</h5>

                    <div class="mb-3">

                        <label class="form-label">
                            Armor
                        </label>

                        <select class="form-select"
                                @bind="selectedArmor">

                            <option value="">
                                (Select armor)
                            </option>

                            @foreach (var a in GetAvailableArmors())
                            {
                                <option value="@a.Name">
                                    @a.Name (@a.ArmorPoints)
                                </option>
                            }

                        </select>

                        <div class="form-text">
                            Highest armor proficiency:
                            <strong>@GetHighestArmorProficiencyName()</strong>
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Main hand
                        </label>

                        <select class="form-select"
                                @onchange="OnMainWeaponChanged">

                            <option value="">
                                (Select main weapon)
                            </option>

                            @foreach (var w in weapons.Where(w =>
                                !(w.Hands?.Contains("Shield") ?? false) &&
                                !(w.Hands?.Contains("TowerShield") ?? false) &&
                                !(w.Hands?.Contains("Armor") ?? false)))
                            {
                                <option value="@w.Name"
                                        selected="@(w.Name == selectedMainWeapon)">
                                    @w.Name (@w.Hands / @w.Range)
                                </option>
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Off hand
                        </label>

                        <select class="form-select"
                                value="@selectedOffWeapon"
                                @onchange="OnOffWeaponChanged"
                                disabled="@IsOffhandDisabled()">

                            <option value="">
                                (Select off-hand)
                            </option>

                            @foreach (var w in weapons)
                            {
                                <option value="@w.Name">
                                    @w.Name (@w.Hands)
                                </option>
                            }

                        </select>

                        @if (IsOffhandDisabled())
                        {
                            <div class="form-text">
                                Off-hand disabled for two-handed or ranged main weapons.
                            </div>
                        }

                    </div>

                </div>


                <div class="card p-3 mb-3">

                    <h5>Attacks</h5>

                    @if (string.IsNullOrEmpty(selectedMainWeapon) &&
                         string.IsNullOrEmpty(selectedOffWeapon))
                    {
                        <div class="text-muted">
                            No weapons equipped.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm">

                            <thead>
                                <tr>
                                    <th>Weapon</th>
                                    <th>Attack</th>
                                    <th>Damage</th>
                                    <th>Pen</th>
                                    <th>Type</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var weapon in equippedWeapons)
                                {
                                    var key = "STR";

                                    var baseVal =
                                        baseStats.ContainsKey(key)
                                            ? baseStats[key]
                                            : 0;

                                    var curVal =
                                        currentStats.ContainsKey(key)
                                            ? currentStats[key]
                                            : baseVal;

                                    featureBonuses.TryGetValue(
                                        key,
                                        out var fb);

                                    var effective =
                                        curVal + fb;

                                    var charBonus =
                                        effective / 10;

                                    <tr>

                                        <td>@weapon.Name</td>

                                        <td>
                                            @if (weapon.Range == "Melee")
                                            {
                                                <span>Melee</span>
                                            }
                                            else
                                            {
                                                <span>Ranged</span>
                                            }
                                        </td>

                                        <td>
                                            @if (weapon.Range == "Melee")
                                            {
                                                <span>
                                                    @weapon.Damage+STR Bonus
                                                    <span class="text-muted">
                                                        (@charBonus)
                                                    </span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    @weapon.Damage
                                                </span>
                                            }
                                        </td>

                                        <td>@weapon.Penetration</td>

                                        <td>@weapon.DamageTypes</td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }

                </div>

            </div>

        </div>

    </div>

    <div class="mt-3">

        <button class="btn btn-primary"
                @onclick="Submit">
            Create
        </button>

    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3">
            @message
        </div>
    }

</div>

<div class="card p-3 mt-3">

    <h5>Save</h5>

    <div class="row g-2 align-items-center">

        <div class="col-auto">

            <button class="btn btn-success"
                    @onclick="SaveCharacter"
                    disabled="@(!CanSave())">
                Save
            </button>

        </div>

    </div>

    @if (!string.IsNullOrEmpty(saveMessage))
    {
        <div class="mt-2 text-muted">
            @saveMessage
        </div>
    }

    <div class="mt-3">

        <label class="form-label">
            Save base folder (optional)
        </label>

        <div class="input-group">

            <input class="form-control"
                   @bind="customBasePath"
                   placeholder="Enter base folder or leave empty for default" />

            <button class="btn btn-outline-primary"
                    @onclick="SetSavePath">
                Set
            </button>

            <button class="btn btn-outline-secondary"
                    @onclick="ResetSavePath">
                Reset to default
            </button>

        </div>

        <div class="form-text mt-1">
            Current save folder: @currentSaveFolder
        </div>

    </div>

</div>

@code {

    [Parameter]
    public ClientCharacterDto? Character { get; set; }

    [Parameter]
    public EventCallback<ClientCharacterDto> OnCharacterLoaded { get; set; }

    [Parameter]
    public EventCallback<ClientCharacterDto> OnCharacterChanged { get; set; }


    [Parameter]
    public List<string> PurchasedSpells { get; set; } = new();

    private List<LocationDto> locations = new();
    private List<string> raceOptions = new();
    private List<SimpleDto> backgrounds = new();
    private List<SimpleDto> trades = new();
    private List<SimpleDto> motivations = new();
    private List<FeatureDto> features = new();
    private List<WeaponDto> weapons = new();
    private List<ArmorDto> armors = new();
    private List<RaceDto> races = new();
    private List<PowerLevelDto> powerLevels = new();
    private List<TalentDto> talentList = new();
    private List<TraitDto> traitList = new();
    private List<SkillDto> skillList = new();
    private List<SpellDto> spellList = new();

    private PowerLevelDto? selectedPowerLevel;

    private int allowedFeatures = 3;

    private string? selectedLocation;
    private string? selectedRace;
    private string? selectedBackground;
    private string? selectedTrade;
    private string? selectedMotivation;

    private string? feature1;
    private string? feature2;
    private string? feature3;
    private string? feature4;

    private string? selectedAristocratSkill1;
    private string? selectedAristocratSkill2;
    private string? selectedScholarSkill;
    private string? selectedArtisanSkill;
    private string? selectedPleasureSkill;

    private Dictionary<int, string> featuresSelected = new();
    private readonly Dictionary<string, int> aristocratSkills = new()
    {
        ["Arcana"] = 23,
        ["Engineering"] = 24,
        ["History"] = 25,
        ["Local"] = 26,
        ["Nature"] = 27,
        ["Religion"] = 28
    };

    private readonly Dictionary<string, int> scholarSkills = new()
    {
        ["Arcana"] = 23,
        ["Engineering"] = 24,
        ["History"] = 25,
        ["Local"] = 26,
        ["Nature"] = 27,
        ["Religion"] = 28
    };

    private readonly Dictionary<string, int> artisanSkills = new()
    {
        ["Alchemy"] = 31,
        ["ArmsAndArmor"] = 32,
        ["BonesAndHides"] = 33,
        ["BowsAndArrows"] = 34,
        ["Glass"] = 35,
        ["Metal"] = 36,
        ["Traps"] = 37,
        ["Wood"] = 38
    };

    private readonly Dictionary<string, int> pleasureSkills = new()
    {
        ["Alchemy"] = 31,
        ["ArmsAndArmor"] = 32,
        ["BonesAndHides"] = 33,
        ["BowsAndArrows"] = 34,
        ["Glass"] = 35,
        ["Metal"] = 36,
        ["Traps"] = 37,
        ["Wood"] = 38
    };

    private Dictionary<string, int> featureBonuses = new();
    private Dictionary<string, int> skillCounts = new();
    private List<string> talents = new();
    private List<string> traits = new();

    private int totalFeatureWounds = 0;
    private int totalFeatureMP = 0;

    private int damage = 0;
    private int loF = 0;

