    // =================================================
    // TOTAL WOUNDS
    // =================================================

    private int GetTotalWounds()
    {
        var baseWounds = 0;

        if (!string.IsNullOrEmpty(selectedRace))
        {
            var r =
                races.FirstOrDefault(
                    x => x.Name == selectedRace);

            if (r != null)
                baseWounds = r.Wounds;
        }

        var con =
            currentStats.ContainsKey("CON")
                ? currentStats["CON"]
                : baseStats.ContainsKey("CON")
                    ? baseStats["CON"]
                    : 0;

        featureBonuses.TryGetValue(
            "CON",
            out var fb);

        var effectiveCon =
            con + fb;

        return
            baseWounds +
            totalFeatureWounds +
            (effectiveCon / 10);
    }

    // =================================================
    // TOTAL MP
    // =================================================

    private int GetTotalMP()
    {
        return totalFeatureMP;
    }

    // =================================================
    // ARMOR POINTS
    // =================================================

    private int GetArmorPoints()
    {
        int armorPoints = 0;

        if (!string.IsNullOrEmpty(selectedArmor))
        {
            var a =
                armors.FirstOrDefault(
                    x => x.Name == selectedArmor);

            if (a != null &&
                a.ArmorPoints.HasValue)
            {
                armorPoints =
                    a.ArmorPoints.Value;
            }
        }

        var con =
            currentStats.ContainsKey("CON")
                ? currentStats["CON"]
                : baseStats.ContainsKey("CON")
                    ? baseStats["CON"]
                    : 0;

        featureBonuses.TryGetValue(
            "CON",
            out var fb);

        var effectiveCon =
            con + fb;

        armorPoints +=
            effectiveCon / 10;

        return armorPoints;
    }

