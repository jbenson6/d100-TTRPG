    // =================================================
    // FEATURE SELECTED
    // =================================================

    private void OnFeatureSelected(
        int slot,
        ChangeEventArgs e)
    {
        var name =
            e.Value?.ToString();

        featureWarnings.Remove(slot);

        if (string.IsNullOrEmpty(name))
        {
            SetFeatureSlot(
                slot,
                null);

            ReapplyAllBonusesSkillsTalentsTraits();

            return;
        }

        var f =
            features.FirstOrDefault(
                x => x.Name == name);

        if (f == null)
        {
            featureWarnings[slot] =
                "Feature not found.";

            SetFeatureSlot(
                slot,
                null);

            ReapplyAllBonusesSkillsTalentsTraits();

            return;
        }

        foreach (var kv in f.PreReqChar)
        {
            var stat =
                kv.Key;

            var req =
                kv.Value;

            featureBonuses.TryGetValue(
                stat,
                out var fb);

            currentStats.TryGetValue(
                stat,
                out var cur);

            var effective =
                cur + fb;

            if (effective < req)
            {
                featureWarnings[slot] =
                    $"Prerequisite not met: {stat} >= {req} required (current {effective})";

                SetFeatureSlot(
                    slot,
                    null);

                ReapplyAllBonusesSkillsTalentsTraits();

                return;
            }
        }

        SetFeatureSlot(
            slot,
            name);

        var value = "";
        if (featuresSelected.TryGetValue(slot, out value))
        {
            featuresSelected.Remove(slot);
        }
        featuresSelected.Add(slot, name);

        ReapplyAllBonusesSkillsTalentsTraits();
    }

