    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || lookupsLoaded)
            return;

        try
        {
            locations =
                await Http.GetFromJsonAsync<List<LocationDto>>(
                    "api/locations")
                ?? new List<LocationDto>();

            backgrounds =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/backgrounds")
                ?? new List<SimpleDto>();

            trades =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/trades")
                ?? new List<SimpleDto>();

            motivations =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/motivations")
                ?? new List<SimpleDto>();

            features =
                await Http.GetFromJsonAsync<List<FeatureDto>>(
                    "api/features")
                ?? new List<FeatureDto>();

            weapons =
                await Http.GetFromJsonAsync<List<WeaponDto>>(
                    "api/weapons")
                ?? new List<WeaponDto>();

            armors =
                await Http.GetFromJsonAsync<List<ArmorDto>>(
                    "api/armor")
                ?? new List<ArmorDto>();

            talentList =
                 await Http.GetFromJsonAsync<List<TalentDto>>(
                    "api/talents")
                ?? new List<TalentDto>();

            traitList =
                 await Http.GetFromJsonAsync<List<TraitDto>>(
                    "api/traits")
                ?? new List<TraitDto>();

            skillList =
                 await Http.GetFromJsonAsync<List<SkillDto>>(
                    "api/skills")
                ?? new List<SkillDto>();

            spellList = await Http.GetFromJsonAsync<List<SpellDto>>(
                    "api/spells")
                ?? new List<SpellDto>();

            try
            {
                spells =
                    await Http.GetFromJsonAsync<List<SpellDto>>(
                        "api/spells")
                    ?? new List<SpellDto>();
            }
            catch
            {
                spells = new List<SpellDto>();
            }

            races =
                await Http.GetFromJsonAsync<List<RaceDto>>(
                    "api/races")
                ?? new List<RaceDto>();

            powerLevels =
                await Http.GetFromJsonAsync<List<PowerLevelDto>>(
                    "api/powerlevels")
                ?? new List<PowerLevelDto>();

            selectedPowerLevel =
                powerLevels.FirstOrDefault(
                    p => p.Name == "Standard")
                ?? powerLevels.FirstOrDefault();

            if (selectedPowerLevel != null)
            {
                allowedFeatures =
                    selectedPowerLevel.Features;

                var mandatory = 9 * 5;

                availablePoints =
                    Math.Max(
                        0,
                        selectedPowerLevel.Points - mandatory);
            }

            await LoadSavedFiles();
            await LoadDiagnostics();

            if (diagnostics != null)
                currentSaveFolder = diagnostics.SaveFolder;

            lookupsLoaded = true;
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load lookups: {ex.Message}";

            lookupsLoaded = true;
        }

        StateHasChanged();
    }

    private List<WeaponDto> GetEquippedWeapons()
    {
        return weapons
            .Where(w =>
                w.Name == selectedMainWeapon ||
                w.Name == selectedOffWeapon)
                .OrderBy(w => w.Name == selectedMainWeapon ? 0 : 1)
            .ToList();
    }

