    // =================================================
    // RACE
    // =================================================

    private void OnRaceChanged(ChangeEventArgs e)
    {
        selectedRace = e.Value?.ToString();

        var r =
            races.FirstOrDefault(
                x => x.Name == selectedRace);

        if (r != null)
        {
            baseStats =
                new Dictionary<string, int>
                {
                    ["MSK"] = r.MSK,
                    ["RSK"] = r.RSK,
                    ["STR"] = r.STR,
                    ["AGI"] = r.AGI,
                    ["CON"] = r.CON,
                    ["INT"] = r.INT,
                    ["PER"] = r.PER,
                    ["WPR"] = r.WPR,
                    ["CHA"] = r.CHA
                };

            currentStats =
                baseStats.ToDictionary(
                    kv => kv.Key,
                    kv => kv.Value + 5);

            var mandatory = 9 * 5;

            if (selectedPowerLevel != null)
            {
                availablePoints =
                    Math.Max(
                        0,
                        selectedPowerLevel.Points - mandatory);

                allowedFeatures =
                    selectedPowerLevel.Features;
            }
            else
            {
                availablePoints =
                    Math.Max(0, 120 - mandatory);
            }
        }
        else
        {
            baseStats.Clear();
            currentStats.Clear();
        }

        ReapplyAllBonusesSkillsTalentsTraits();
    }

    // =================================================
    // MAIN WEAPON
    // =================================================

    private void OnMainWeaponChanged(ChangeEventArgs e)
    {
        selectedMainWeapon =
            e.Value?.ToString();

        var w =
            weapons.FirstOrDefault(
                x => x.Name == selectedMainWeapon);

        if (w != null)
        {
            bool disableOff = false;

            if (!string.IsNullOrEmpty(w.Hands) &&
                w.Hands.Contains("TwoHanded"))
            {
                disableOff = true;
            }

            if (!string.IsNullOrEmpty(w.Range) &&
                !w.Range.Contains("Melee"))
            {
                disableOff = true;
            }

            if (disableOff)
            {
                selectedOffWeapon = null;
            }
        }

        equippedWeapons = GetEquippedWeapons();

        ReapplyAllBonusesSkillsTalentsTraits();
    }

