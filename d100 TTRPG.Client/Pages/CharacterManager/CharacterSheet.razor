    }

    // =================================================
    // SAVE CHARACTER
    // =================================================

    private async Task SaveCharacter()
    {
        if (!CanSave())
        {
            saveMessage =
                "Provide Name, Location and Race before saving.";

            return;
        }

        RebuildLearnedSpells();

        var dto = new ClientCharacterDto
        {
            Name = characterName,

            PowerLevel =
                selectedPowerLevel?.Name,

            Location =
                selectedLocation,

            Race =
                selectedRace,

            Background =
                selectedBackground,

            Trade =
                selectedTrade,

            Motivation =
                selectedMotivation,

            Features =
                new List<string?>
                {
                feature1,
                feature2,
                feature3,
                feature4
                }
                .Where(s => !string.IsNullOrEmpty(s))
                .Select(s => s!)
                .ToList(),

            PurchasedFeatures = purchasedFeatures
                                        .Where(s => !string.IsNullOrEmpty(s))
                                        .Select(s => s!)
                                        .ToList(),

            Talents =
                talents
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .OrderBy(t => t)
                    .ToList(),

            PurchasedTalents = purchasedTalents
                                    .Where(t => !string.IsNullOrWhiteSpace(t))
                                    .Distinct()
                                    .OrderBy(t => t)
                                    .ToList(),

            Traits =
                traits
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .Distinct()
                    .OrderBy(t => t)
                    .ToList(),

            Skills =
                skillCounts
                    .Where(x => x.Value > 0)
                    .OrderBy(x => x.Key)
                    .Select(x => x.Key)
                    .ToList(),

            BackgroundSkills =
                GetLookupSkills(backgrounds, selectedBackground),

            BackgroundSkillChoices = GetBackgroundChoices(),

            TradeSkills =
                GetLookupSkills(trades, selectedTrade),

            TradeSkillChoices = GetTradeChoices(),

            MotivationSkills =
                GetLookupSkills(motivations, selectedMotivation),

            MotivationSkillChoices = GetMotivationChoices(),

            AristocratSkill1 =
                selectedAristocratSkill1,

            AristocratSkill2 =
                selectedAristocratSkill2,

            ScholarSkill =
                selectedScholarSkill,

            ArtisanSkill =
                selectedArtisanSkill,

            PleasureSkill =
                selectedPleasureSkill,

            Armor =
                selectedArmor,

            MainWeapon =
                selectedMainWeapon,

            OffWeapon =
                selectedOffWeapon,

            CurrentStats =
                new Dictionary<string, int>(
                    currentStats),

            AvailablePoints =
                availablePoints,

            // -------------------------------------------------
            // SPELL / XP PERSISTENCE
            // -------------------------------------------------

            XpPool = xpPool,

            XpSpent = xpSpent,

            LearnedSpells =
                learnedSpells
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .OrderBy(x => x)
                    .ToList(),

            PurchasedSpells =
                purchasedSpells
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .OrderBy(x => x)
                    .ToList(),
            MP = totalFeatureMP,
            CharacteristicImprovementSteps = new Dictionary<string, int>(
                    characteristicImprovementSteps)
        };

        try
        {
            var res =
                await Http.PostAsJsonAsync(
                    "api/characters",
                    dto);

            if (res.IsSuccessStatusCode)
            {
                try
                {
                    using var stream =
                        await res.Content.ReadAsStreamAsync();

                    using var doc =
                        await System.Text.Json.JsonDocument
                            .ParseAsync(stream);

                    if (doc.RootElement.TryGetProperty(
                        "path",
                        out var pathProp))
                    {
                        saveMessage =
                            $"Saved: {pathProp.GetString()}";
                    }
                    else if (doc.RootElement.TryGetProperty(
                        "file",
                        out var fileProp))
                    {
                        saveMessage =
                            $"Saved: {fileProp.GetString()}";
                    }
                    else
                    {
                        saveMessage = "Saved.";
                    }
                }
                catch
                {
                    saveMessage = "Saved.";
                }

                await LoadSavedFiles();
            }
            else
            {
                var errorBody =
                    await res.Content.ReadAsStringAsync();

                saveMessage =
                    $"Save failed: {res.StatusCode}" +
                    (string.IsNullOrWhiteSpace(errorBody)
                        ? ""
                        : $" - {errorBody}");
            }
        }
        catch (Exception ex)
        {
            saveMessage =
                "Save error: " + ex.Message;
        }
    }

    // =================================================
    // LOOKUP SKILLS
    // =================================================

    private List<string> GetLookupSkills(
        IEnumerable<SimpleDto> lookup,
        string? selectedName)
    {
        if (string.IsNullOrWhiteSpace(selectedName))
            return new List<string>();

        return
            lookup
                .FirstOrDefault(x => x.Name == selectedName)?
                .Skills?
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToList()
            ?? new List<string>();
    }

    private List<string> GetBackgroundChoices()
    {
        switch (selectedBackground)
        {
            case "Aristocrat":
                return new List<string>() { selectedAristocratSkill1, selectedAristocratSkill2 };
            default:
                return null;
        }
    }

    private List<string> GetTradeChoices()
    {
        switch (selectedTrade)
        {
            case "Artisan":
                return new List<string>() { selectedArtisanSkill };
            case "Scholar":
                return new List<string>() { selectedScholarSkill };
            default:
                return null;
        }
    }

    private List<string> GetMotivationChoices()
    {
        switch (selectedMotivation)
        {
            case "Pleasure":
                return new List<string>() { selectedPleasureSkill };
                break;
            default:
                return null;
                break;
        }
    }

    // =================================================
    // REBUILD LEARNED SPELLS
    // =================================================

    private void RebuildLearnedSpells()
    {
        learnedSpells.Clear();

        foreach (var spell in purchasedSpells)
        {
            if (!string.IsNullOrWhiteSpace(spell))
            {
                learnedSpells.Add(spell);
            }
        }

        var race =
            races.FirstOrDefault(
                r => r.Name == selectedRace);

        if (race != null)
        {
            foreach (var spell in race.Spells)
            {
                if (!string.IsNullOrWhiteSpace(spell))
                {
                    learnedSpells.Add(spell);
                }
            }
        }

        var selectedFeatures = new[]
        {
            feature1,
            feature2,
            feature3,
            feature4
        };

        foreach (var fname in selectedFeatures)
        {
            if (string.IsNullOrEmpty(fname))
                continue;

            switch (fname)
            {
                case "BardicPerformance":
                case "Channel":
                case "Counterspell":
                case "EldritchBlast":
                case "LayOnHands":
                case "Purify":
                case "Smite":
                    learnedSpells.Add(fname);
                    break;
            }
        }
    }



