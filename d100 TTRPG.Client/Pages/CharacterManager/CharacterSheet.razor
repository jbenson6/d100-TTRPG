    protected override void OnParametersSet()
    {
        if (Character == null)
            return;

        purchasedSpells =
            Character.PurchasedSpells != null
                ? new HashSet<string>(Character.PurchasedSpells)
                : new HashSet<string>();

        learnedSpells =
            Character.LearnedSpells != null
                ? new HashSet<string>(Character.LearnedSpells)
                : new HashSet<string>();

        xpPool = Character.XpPool;
        xpSpent = Character.XpSpent;
        totalFeatureMP = Character.MP;


        // ============================================================
        // CURRENT CHARACTERISTICS
        // ============================================================

        currentStats = new Dictionary<string, int>
        {
            ["MSK"] = Character.CurrentStats["MSK"],
            ["RSK"] = Character.CurrentStats["RSK"],
            ["STR"] = Character.CurrentStats["STR"],
            ["AGI"] = Character.CurrentStats["AGI"],
            ["CON"] = Character.CurrentStats["CON"],
            ["INT"] = Character.CurrentStats["INT"],
            ["PER"] = Character.CurrentStats["PER"],
            ["WPR"] = Character.CurrentStats["WPR"],
            ["CHA"] = Character.CurrentStats["CHA"]
        };

        // ============================================================
        // FEATURES
        // ============================================================

        Dictionary<int, string> dict = new Dictionary<int, string>();

        for (int i = 0; i < Character.Features.Count; i++)
        {
            dict.Add(i + 1, Character.Features[i]);
        }

        featuresSelected = dict;

        // ============================================================
        // TALENTS
        // ============================================================

        talents =
            Character.Talents != null
                ? new List<string>(Character.Talents)
                : new List<string>();

        purchasedFeatures = Character.PurchasedFeatures != null 
                                ? new HashSet<string>(Character.PurchasedFeatures)
                                : new HashSet<string>();

        characteristicImprovementSteps = Character.CharacteristicImprovementSteps != null
                                ? new Dictionary<string, int>(Character.CharacteristicImprovementSteps)
                                : new Dictionary<string, int>();

        purchasedTalents = Character.PurchasedTalents != null
                                ? new HashSet<string>(Character.PurchasedTalents)
                                : new HashSet<string>();

    }

