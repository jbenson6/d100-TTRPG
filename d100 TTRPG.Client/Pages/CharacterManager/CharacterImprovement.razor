@using d100_TTRPG.Shared.Data_Objects
@inject HttpClient Http

<h3>Character Improvement</h3>

<div class="mb-2">

    <!-- ================================================= -->
    <!-- XP -->
    <!-- ================================================= -->

    <div class="row">
        <div class="col-md-8">

            <div class="d-flex align-items-center gap-2 mb-2">

                <label class="form-label mb-0">
                    XP Amount
                </label>

                <input type="number"
                       class="form-control"
                       style="width: 120px;"
                       min="1"
                       @bind="xpAdjustment" />

                <button class="btn btn-sm btn-outline-success"
                        @onclick="AddCustomXP"
                        disabled="@(xpAdjustment <= 0)">
                    + XP
                </button>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="RemoveCustomXP"
                        disabled="@(xpAdjustment <= 0 || xpPool - xpAdjustment < xpSpent)">
                    − XP
                </button>

            </div>

            <div>

                <span class="me-3">
                    XP Pool:
                    <strong>@xpPool</strong>
                </span>

                <span class="me-3">
                    XP Spent:
                    <strong>@xpSpent</strong>
                </span>

                <span>
                    XP Remaining:
                    <strong>@xpRemaining</strong>
                </span>

            </div>

        </div>
    </div>


    <!-- ================================================= -->
    <!-- IMPROVEMENTS -->
    <!-- ================================================= -->

    <div class="row mt-3">

        <!-- ================================================= -->
        <!-- SPELLS -->
        <!-- ================================================= -->

        <div class="col-md-4">

            <h6>Spells</h6>

            @if (spells != null && spells.Any())
            {
                @foreach (var s in spells
                    .Where(s => s.MP <= GetTotalMP())
                    .OrderBy(s => s.Name))
                {
                    var spellName = s.Name ?? "";

                    var isLearned =
                        learnedSpells.Contains(spellName);

                    <div class="mb-1">

                        <input type="checkbox"
                               checked="@isLearned"
                               disabled="@(!isLearned && xpRemaining < s.XpCost)"
                               @onchange="e => OnSpellToggled(
                                                           s.Name,
                                                           s.XpCost,
                                                           e)" />

<label class="ms-1">
                            @s.Name (@s.XpCost xp)
                        </label>

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No spells loaded.
                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- TALENTS -->
        <!-- ================================================= -->

        <div class="col-md-4">

            <h6>Talents</h6>

            @if (talents != null && talents.Any())
            {
                @foreach (var t in talents
                    .Where(t => !string.IsNullOrWhiteSpace(t.Name))
                    .OrderBy(t => t.Name))
                {
                    var talentName = t.Name ?? "";

                    var isOwned =
                        characterTalents.Contains(talentName);

                    var isPurchased =
                        purchasedTalents.Contains(talentName);

                    var isChecked =
                        isOwned || isPurchased;

                    var xpCost =
                        t.XpCost;

                    <div class="mb-1">

                        <input type="checkbox"
                               checked="@isChecked"
                               disabled="@(!isChecked && xpRemaining < xpCost)"
                               @onchange="e => OnTalentToggled(
                                                           talentName,
                                                           xpCost,
                                                           e)" />

<label class="ms-1">
                            @talentName (@xpCost xp)
                        </label>

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No talents loaded.
                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- FEATURES -->
        <!-- ================================================= -->

        <div class="col-md-4">

            <h6>Features</h6>

            @if (features != null && features.Any())
            {
                @foreach (var f in features
                    .Where(f => !string.IsNullOrWhiteSpace(f.Name))
                    .OrderBy(f => f.Name))
                {
                    var featureName = f.Name ?? "";

                    var isOwned =
                        characterFeatures.Contains(featureName);

                    var isPurchased =
                        purchasedFeatures.Contains(featureName);

                    var isChecked =
                        isOwned || isPurchased;

                    const int featureXpCost = 1000;

                    <div class="mb-1">

                        <input type="checkbox"
                               checked="@isChecked"
                               disabled="@(!isChecked && xpRemaining < featureXpCost)"
                               @onchange="e => OnFeatureToggled(
                                                           featureName,
                                                           featureXpCost,
                                                           e)" />

<label class="ms-1">
                            @featureName (@featureXpCost xp)
                        </label>

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No features loaded.
                </div>
            }

        </div>

    </div>

</div>


@code {

    // ============================================================
    // DATA
    // ============================================================

    private List<SpellDto> spells = new();

    private List<TalentDto> talents = new();

    private List<FeatureDto> features = new();

    private List<LocationDto> locations = new();

    private List<string> raceOptions = new();

    private List<SimpleDto> backgrounds = new();

    private List<SimpleDto> trades = new();

    private List<SimpleDto> motivations = new();

    private List<WeaponDto> weapons = new();

    private List<ArmorDto> armors = new();

    private List<RaceDto> races = new();

    private List<PowerLevelDto> powerLevels = new();


    // ============================================================
    // SPELL TRACKING
    // ============================================================

    private HashSet<string> learnedSpells = new();

    private HashSet<string> purchasedSpells = new();


    // ============================================================
    // TALENT TRACKING
    // ============================================================

    // Talents the character already owns from character creation,
    // race, background, trade, etc.
    private HashSet<string> characterTalents = new();

    // Talents specifically purchased with XP.
    private HashSet<string> purchasedTalents = new();


    // ============================================================
    // FEATURE TRACKING
    // ============================================================

    // Features the character already owns.
    private HashSet<string> characterFeatures = new();

    // Features specifically purchased with XP.
    private HashSet<string> purchasedFeatures = new();


    // ============================================================
    // CHARACTER DATA
    // ============================================================

    private int xpPool = 1000;

    private int xpSpent = 0;

    private int characterMP = 0;

    private int xpAdjustment = 50;


    private PowerLevelDto? selectedPowerLevel;

    private int allowedFeatures = 3;

    private string? selectedLocation;

    private string? selectedRace;

    private string? selectedBackground;

    private string? selectedTrade;

    private string? selectedMotivation;


    // ============================================================
    // FEATURES FROM CHARACTER CREATION
    // ============================================================

    private string? feature1;

    private string? feature2;

    private string? feature3;

    private string? feature4;


    // ============================================================
    // SKILLS
    // ============================================================

    private string? selectedAristocratSkill1;

    private string? selectedAristocratSkill2;

    private string? selectedScholarSkill;

    private string? selectedArtisanSkill;

    private string? selectedPleasureSkill;


    // ============================================================
    // XP
    // ============================================================

    private int xpRemaining =>
        Math.Max(
            0,
            xpPool - xpSpent);


    private int GetTotalMP()
    {
        return characterMP;
    }


    // ============================================================
    // ADD XP
    // ============================================================

    private void AddCustomXP()
    {
        if (xpAdjustment <= 0)
            return;

        xpPool += xpAdjustment;
    }


    // ============================================================
    // REMOVE XP
    // ============================================================

    private void RemoveCustomXP()
    {
        if (xpAdjustment <= 0)
            return;

        // Never allow XP Pool to drop below XP already spent.
        var maximumRemoval =
            xpPool - xpSpent;

        if (maximumRemoval <= 0)
            return;

        var amountToRemove =
            Math.Min(
                xpAdjustment,
                maximumRemoval);

        xpPool -= amountToRemove;
    }


    // ============================================================
    // SPELL TOGGLE
    // ============================================================

    private async Task OnSpellToggled(
        string? spellName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool value && value;

        if (string.IsNullOrWhiteSpace(spellName))
            return;


        if (isChecked)
        {
            // Already purchased.
            if (purchasedSpells.Contains(spellName))
                return;

            // Cannot purchase if insufficient XP.
            if (xpRemaining < xpCost)
                return;

            purchasedSpells.Add(
                spellName);

            xpSpent += xpCost;
        }
        else
        {
            // Only purchased spells can be refunded.
            if (purchasedSpells.Remove(spellName))
            {
                xpSpent =
                    Math.Max(
                        0,
                        xpSpent - xpCost);
            }
        }


        RebuildLearnedSpells();

        await NotifyCharacterChanged();
    }


    // ============================================================
    // TALENT TOGGLE
    // ============================================================

    private async Task OnTalentToggled(
        string talentName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool value && value;

        if (string.IsNullOrWhiteSpace(talentName))
            return;


        if (isChecked)
        {
            // Already owned before XP purchases.
            if (characterTalents.Contains(talentName))
                return;

            // Already purchased.
            if (purchasedTalents.Contains(talentName))
                return;

            // Not enough XP.
            if (xpRemaining < xpCost)
                return;

            purchasedTalents.Add(
                talentName);

            xpSpent += xpCost;
        }
        else
        {
            // Only refund talents purchased with XP.
            if (purchasedTalents.Remove(talentName))
            {
                xpSpent =
                    Math.Max(
                        0,
                        xpSpent - xpCost);
            }
        }


        await NotifyCharacterChanged();
    }


    // ============================================================
    // FEATURE TOGGLE
    // ============================================================

    private async Task OnFeatureToggled(
        string featureName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool value && value;

        if (string.IsNullOrWhiteSpace(featureName))
            return;


        if (isChecked)
        {
            // Already owned before XP purchases.
            if (characterFeatures.Contains(featureName))
                return;

            // Already purchased.
            if (purchasedFeatures.Contains(featureName))
                return;

            // Not enough XP.
            if (xpRemaining < xpCost)
                return;

            purchasedFeatures.Add(
                featureName);

            xpSpent += xpCost;
        }
        else
        {
            // Only refund features purchased with XP.
            if (purchasedFeatures.Remove(featureName))
            {
                xpSpent =
                    Math.Max(
                        0,
                        xpSpent - xpCost);
            }
        }


        await NotifyCharacterChanged();
    }


    // ============================================================
    // UPDATE CHARACTER
    // ============================================================

    private async Task NotifyCharacterChanged()
    {
        if (Character == null)
            return;


        // ========================================================
        // XP
        // ========================================================

        Character.XpPool =
            xpPool;

        Character.XpSpent =
            xpSpent;


        // ========================================================
        // PURCHASED SPELLS
        // ========================================================

        Character.PurchasedSpells =
            purchasedSpells
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // LEARNED SPELLS
        // ========================================================

        Character.LearnedSpells =
            learnedSpells
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // TALENTS
        // ========================================================

        var allTalents =
            new HashSet<string>(
                characterTalents);

        foreach (var talent in purchasedTalents)
        {
            allTalents.Add(
                talent);
        }

        Character.Talents =
            allTalents
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // FEATURES
        // ========================================================

        var allFeatures =
            new HashSet<string>(
                characterFeatures);

        foreach (var feature in purchasedFeatures)
        {
            allFeatures.Add(
                feature);
        }

        Character.Features =
            allFeatures
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // NOTIFY PARENT
        // ========================================================

        await OnCharacterChanged.InvokeAsync(
            Character);
    }


    // ============================================================
    // LOAD API DATA
    // ============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            locations =
                await Http.GetFromJsonAsync<List<LocationDto>>(
                    "api/locations")
                ?? new List<LocationDto>();


            backgrounds =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/backgrounds")
                ?? new List<SimpleDto>();


            trades =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/trades")
                ?? new List<SimpleDto>();


            motivations =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/motivations")
                ?? new List<SimpleDto>();


            features =
                await Http.GetFromJsonAsync<List<FeatureDto>>(
                    "api/features")
                ?? new List<FeatureDto>();


            talents =
                await Http.GetFromJsonAsync<List<TalentDto>>(
                    "api/talents")
                ?? new List<TalentDto>();


            weapons =
                await Http.GetFromJsonAsync<List<WeaponDto>>(
                    "api/weapons")
                ?? new List<WeaponDto>();


            armors =
                await Http.GetFromJsonAsync<List<ArmorDto>>(
                    "api/armor")
                ?? new List<ArmorDto>();


            spells =
                await Http.GetFromJsonAsync<List<SpellDto>>(
                    "api/spells")
                ?? new List<SpellDto>();


            races =
                await Http.GetFromJsonAsync<List<RaceDto>>(
                    "api/races")
                ?? new List<RaceDto>();
        }
        catch
        {
            // Keep already initialized collections.
        }


        StateHasChanged();
    }


    // ============================================================
    // PARAMETERS
    // ============================================================

    [Parameter]
    public ClientCharacterDto? Character { get; set; }


    [Parameter]
    public EventCallback<ClientCharacterDto>
        OnCharacterChanged
    { get; set; }


    private bool characterLoaded = false;


    // ============================================================
    // CHARACTER PARAMETERS CHANGED
    // ============================================================

    protected override void OnParametersSet()
    {
        if (Character == null)
            return;

        LoadCharacterData(
            Character);
    }


    // ============================================================
    // LOAD CHARACTER
    // ============================================================

    private void LoadCharacterData(
        ClientCharacterDto dto)
    {
        // ========================================================
        // XP
        // ========================================================

        xpPool =
            Math.Max(
                0,
                dto.XpPool);

        xpSpent =
            Math.Max(
                0,
                dto.XpSpent);


        // ========================================================
        // PURCHASED SPELLS
        // ========================================================

        purchasedSpells =
            dto.PurchasedSpells != null
                ? new HashSet<string>(
                    dto.PurchasedSpells
                        .Where(s =>
                            !string.IsNullOrWhiteSpace(s)))
                : new HashSet<string>();


        // ========================================================
        // LEARNED SPELLS
        // ========================================================

        learnedSpells =
            dto.LearnedSpells != null
                ? new HashSet<string>(
                    dto.LearnedSpells
                        .Where(s =>
                            !string.IsNullOrWhiteSpace(s)))
                : new HashSet<string>();


        // ========================================================
        // EXISTING TALENTS
        // ========================================================

        characterTalents =
            dto.Talents != null
                ? new HashSet<string>(
                    dto.Talents
                        .Where(t =>
                            !string.IsNullOrWhiteSpace(t)))
                : new HashSet<string>();


        // ========================================================
        // EXISTING FEATURES
        // ========================================================

        characterFeatures =
            dto.Features != null
                ? new HashSet<string>(
                    dto.Features
                        .Where(f =>
                            !string.IsNullOrWhiteSpace(f)))
                : new HashSet<string>();


        // ========================================================
        // CHARACTER CREATION DATA
        // ========================================================

        selectedRace =
            dto.Race;


        feature1 =
            dto.Features != null &&
            dto.Features.Count > 0
                ? dto.Features[0]
                : null;


        feature2 =
            dto.Features != null &&
            dto.Features.Count > 1
                ? dto.Features[1]
                : null;


        feature3 =
            dto.Features != null &&
            dto.Features.Count > 2
                ? dto.Features[2]
                : null;


        feature4 =
            dto.Features != null &&
            dto.Features.Count > 3
                ? dto.Features[3]
                : null;


        characterMP =
            dto.MP;


        characterLoaded =
            true;


        RebuildLearnedSpells();
    }


    // ============================================================
    // REBUILD LEARNED SPELLS
    // ============================================================

    private void RebuildLearnedSpells()
    {
        learnedSpells.Clear();


        // ========================================================
        // PURCHASED SPELLS
        // ========================================================

        foreach (var spell in purchasedSpells)
        {
            if (!string.IsNullOrWhiteSpace(spell))
            {
                learnedSpells.Add(
                    spell);
            }
        }


        // ========================================================
        // RACE SPELLS
        // ========================================================

        var race =
            races.FirstOrDefault(
                r => r.Name == selectedRace);


        if (race != null)
        {
            foreach (var spell in race.Spells)
            {
                if (!string.IsNullOrWhiteSpace(spell))
                {
                    learnedSpells.Add(
                        spell);
                }
            }
        }


        // ========================================================
        // FEATURE SPELLS
        // ========================================================

        var selectedFeatures =
            new[]
            {
                feature1,
                feature2,
                feature3,
                feature4
            };


        foreach (var fname in selectedFeatures)
        {
            if (string.IsNullOrEmpty(fname))
                continue;


            switch (fname)
            {
                case "BardicPerformance":

                case "Channel":

                case "Counterspell":

                case "EldritchBlast":

                case "LayOnHands":

                case "Purify":

                case "Smite":

                    learnedSpells.Add(
                        fname);

                    break;
            }
        }
    }


    // ============================================================
    // DTOs
    // ============================================================

    private class LocationDto
    {
        public string? Name { get; set; }

        public List<string>? Races { get; set; }
    }


    private class SimpleDto
    {
        public string? Name { get; set; }

        public string? Description { get; set; }

        public string? AdditionalNotes { get; set; }

        public List<string>? Skills { get; set; }

        public string? Talent { get; set; }

        public List<string>? Traits { get; set; }

        public List<string>? Equipment { get; set; }
    }


    private class WeaponDto
    {
        public string? Name { get; set; }

        public string? Hands { get; set; }

        public string? Range { get; set; }

        public string? Damage { get; set; }

        public int Penetration { get; set; }

        public string? DamageTypes { get; set; }

        public List<string> Traits { get; set; } =
            new();
    }


    private class ArmorDto
    {
        public string? Name { get; set; }

        public int? ArmorPoints { get; set; }
    }


    private class RaceDto
    {
        public string? Name { get; set; }

        public int Wounds { get; set; }

        public int MSK { get; set; }

        public int RSK { get; set; }

        public int STR { get; set; }

        public int AGI { get; set; }

        public int CON { get; set; }

        public int INT { get; set; }

        public int PER { get; set; }

        public int WPR { get; set; }

        public int CHA { get; set; }

        public List<string> Skills { get; set; } =
            new();

        public List<string> Talents { get; set; } =
            new();

        public List<string> Languages { get; set; } =
            new();

        public List<string> Traits { get; set; } =
            new();

        public List<string> Spells { get; set; } =
            new();

        public List<string> Features { get; set; } =
            new();
    }


    private class PowerLevelDto
    {
        public string? Name { get; set; }

        public int Points { get; set; }

        public int Features { get; set; }

        public string? Description { get; set; }
    }


    private class DiagnosticsInfo
    {
        public string? SaveFolder { get; set; }

        public bool FolderExists { get; set; }

        public bool CanWrite { get; set; }

        public string? WriteTestError { get; set; }

        public string? DriveRoot { get; set; }

        public long AvailableFreeBytes { get; set; }

        public string? ServerUser { get; set; }
    }


    private class SpellDto
    {
        public string? Name { get; set; }

        public int XpCost { get; set; }

        public int MP { get; set; }

        public int CastDifficulty { get; set; }

        public string? MagicSchool { get; set; }

        public int Range { get; set; }

        public int NumTargets { get; set; }
    }


    private class TalentDto
    {
        public string? Name { get; set; }

        public int XpCost { get; set; }

        public string? Description { get; set; }

        public List<string> Skills { get; set; } =
            new();

        public List<string> Traits { get; set; } =
            new();

        public List<string> CharBonuses { get; set; } =
            new();
    }


    private class FeatureDto
    {
        public string? Name { get; set; }

        public int MP { get; set; }

        public int Wounds { get; set; }

        public string? Armor { get; set; }

        public string? Description { get; set; }

        public List<string> CharBonuses { get; set; } =
            new();

        public Dictionary<string, int> PreReqChar { get; set; } =
            new();

        public List<string> Skills { get; set; } =
            new();

        public List<string> Talents { get; set; } =
            new();
    }
}