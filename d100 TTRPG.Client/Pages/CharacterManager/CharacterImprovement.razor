@using d100_TTRPG.Shared.Data_Objects
@inject HttpClient Http

<h3>Character Improvement</h3>

<div class="mb-2">

    <!-- ================================================= -->
    <!-- XP -->
    <!-- ================================================= -->

    <div class="row">
        <div class="col-md-8">

            <div class="d-flex align-items-center gap-2 mb-2">

                <label class="form-label mb-0">
                    XP Amount
                </label>

                <input type="number"
                       class="form-control"
                       style="width: 120px;"
                       min="1"
                       @bind="xpAdjustment" />

                <button class="btn btn-sm btn-outline-success"
                        @onclick="AddCustomXP"
                        disabled="@(xpAdjustment <= 0)">
                    + XP
                </button>

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="RemoveCustomXP"
                        disabled="@(xpAdjustment <= 0 || xpPool - xpAdjustment < xpSpent)">
                    − XP
                </button>

            </div>

            <div>

                <span class="me-3">
                    XP Pool:
                    <strong>@xpPool</strong>
                </span>

                <span class="me-3">
                    XP Spent:
                    <strong>@xpSpent</strong>
                </span>

                <span>
                    XP Remaining:
                    <strong>@xpRemaining</strong>
                </span>

            </div>

        </div>
    </div>


    <!-- ================================================= -->
    <!-- CHARACTERISTICS -->
    <!-- ================================================= -->

    <div class="row mt-3">

        <div class="col-md-12">

            <h6>Characteristics</h6>

            <div class="row">

                @foreach (var characteristic in characteristics)
                {
                    var steps =
                        GetCharacteristicImprovementSteps(
                            characteristic);

                    var cost =
                        GetCharacteristicImprovementCost(
                            characteristic);

                    var currentValue =
                        GetCharacteristicValue(
                            characteristic);

                    featureBonuses.TryGetValue(
                                        characteristic,
                                        out var fb);

                    var effective = currentValue + fb;

                    var maxed =
                        steps >= 4;

                    var canPurchase =
                        !maxed &&
                        xpRemaining >= cost;

                    <div class="col-md-4 col-lg-3 mb-2">

                        <div class="border rounded p-2">

                            <div class="d-flex justify-content-between">

                                <strong>
                                    @characteristic
                                </strong>

                                <span>
                                    @effective
                                </span>

                            </div>

                            <div class="small text-muted mb-1">

                                Improvement:
                                @steps / 4

                            </div>

                            @if (maxed)
                            {
                                <div class="text-success small">
                                    Maximum reached
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center">

                                    <button class="btn btn-sm btn-outline-success"
                                           disabled="@(!canPurchase)"
                                           @onclick="e => OnCharacteristicToggled(characteristic)" > + </button>

                                    <label class="ms-1">
                                        +5 (@cost xp)
                                    </label>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- IMPROVEMENTS -->
    <!-- ================================================= -->

    <div class="row mt-3">

        <!-- ================================================= -->
        <!-- SPELLS -->
        <!-- ================================================= -->

        <div class="col-md-4">

            <h6>Spells</h6>

            @if (spells != null && spells.Any())
            {
                @foreach (var s in spells
                    .Where(s => s.MP <= GetTotalMP())
                    .OrderBy(s => s.Name))
                {
                    var spellName = s.Name ?? "";

                    var isLearned =
                        learnedSpells.Contains(spellName);

                    var description = GetSpellDescription(spellName);
                    <div class="mb-1">

                        <input type="checkbox"
                               checked="@isLearned"
                               disabled="@(!isLearned && xpRemaining < s.XpCost)"
                               @onchange="e => OnSpellToggled(
                                                           s.Name,
                                                           s.XpCost,
                                                           e)" />

                        <label class="ms-1 description-hover" data-description="@description">
                            @s.Name (@s.XpCost xp)
                        </label>

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No spells loaded.
                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- TALENTS -->
        <!-- ================================================= -->

        <div class="col-md-4">

            <h6>Talents</h6>

            @if (talents != null && talents.Any())
            {
                @foreach (var t in talents
                    .Where(t => !string.IsNullOrWhiteSpace(t.Name))
                    .OrderBy(t => t.Name))
                {
                    var talentName = t.Name ?? "";

                    var isMagicProficiency =
                        IsMagicProficiency(talentName);

                    var isOwned =
                        characterTalents.Contains(talentName);

                    var isPurchased =
                        purchasedTalents.Contains(talentName);

                    var isChecked =
                        isOwned || isPurchased;

                    var xpCost =
                        isMagicProficiency
                            ? MagicProficiencyXpCost
                            : t.XpCost;

                    var magicProficiencyMaxed =
                        isMagicProficiency &&
                        characterMP >= MaximumMP;

                    var canPurchase =
                        !isMagicProficiency
                            ? (!isChecked && xpRemaining >= xpCost)
                            : (!magicProficiencyMaxed &&
                               xpRemaining >= xpCost);

                    var description = GetTalentDescription(talentName);

                    <div class="mb-1">

                        @if (isMagicProficiency)
                        {
                            <button class="btn btn-sm btn-outline-success"
                                   disabled="@(!canPurchase)"
                                   @onclick="e => OnMagicProficiencyToggled()" > + </button>
                        }
                        else
                        {
                            <input type="checkbox"
                                   checked="@isChecked"
                                   disabled="@(!isChecked && xpRemaining < xpCost)"
                                   @onchange="e => OnTalentToggled(
                                                                   talentName,
                                                                   xpCost,
                                                                   e)" />
                        }

                        <label class="ms-1 description-hover"
                               data-description="@description">

                            @talentName
                            (@xpCost xp)

                            @if (isMagicProficiency)
                            {
                                <span class="text-muted">
                                    — MP @characterMP / @MaximumMP
                                </span>
                            }

                        </label>

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No talents loaded.
                </div>
            }

        </div>


        <!-- ================================================= -->
        <!-- FEATURES -->
        <!-- ================================================= -->

        <div class="col-md-4">

            <h6>Features</h6>

            @if (features != null && features.Any())
            {
                @foreach (var f in features
                    .Where(f => !string.IsNullOrWhiteSpace(f.Name))
                    .OrderBy(f => f.Name))
                {
                    var featureName = f.Name ?? "";

                    var isOwned =
                        characterFeatures.Contains(featureName);

                    var isPurchased =
                        purchasedFeatures.Contains(featureName);

                    var isChecked =
                        isOwned || isPurchased;

                    const int featureXpCost = 1000;

                    var description = GetFeatureDescription(featureName);

                    <div class="mb-1">

                        <input type="checkbox"
                               checked="@isChecked"
                               disabled="@((!isChecked && xpRemaining < featureXpCost) || isOwned)"
                               @onchange="e => OnFeatureToggled(
                                                                                   featureName,
                                                                                   featureXpCost,
                                                                                   e)" />
                            <label class="ms-1 description-hover"
                                data-description="@description">
                                @featureName (@featureXpCost xp)
                            </label>
                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    No features loaded.
                </div>
            }

        </div>

    </div>

</div>


@code {

    // ============================================================
    // CONSTANTS
    // ============================================================

    private const string MagicProficiencyTalent =
        "Magic Proficiency (X)";

    private const int MagicProficiencyXpCost =
        500;

    private const int MaximumMP =
        10;

    private const int MaximumCharacteristicImprovements =
        4;


    // ============================================================
    // CHARACTERISTICS
    // ============================================================

    private readonly List<string> characteristics =
        new()
        {
            "MSK",
            "RSK",
            "STR",
            "AGI",
            "CON",
            "INT",
            "PER",
            "WPR",
            "CHA"
        };


    // ============================================================
    // DATA
    // ============================================================

    private List<SpellDto> spells = new();

    private List<TalentDto> talents = new();

    private List<FeatureDto> features = new();

    private List<LocationDto> locations = new();

    private List<string> raceOptions = new();

    private List<SimpleDto> backgrounds = new();

    private List<SimpleDto> trades = new();

    private List<SimpleDto> motivations = new();

    private List<WeaponDto> weapons = new();

    private List<ArmorDto> armors = new();

    private List<RaceDto> races = new();

    private List<PowerLevelDto> powerLevels = new();


    // ============================================================
    // SPELL TRACKING
    // ============================================================

    private HashSet<string> learnedSpells = new();

    private HashSet<string> purchasedSpells = new();


    // ============================================================
    // TALENT TRACKING
    // ============================================================

    // Talents already owned by the character.
    private HashSet<string> characterTalents = new();

    // Talents purchased with XP.
    //
    // This MUST be a List rather than a HashSet because
    // Magic Proficiency can be purchased multiple times.
    private List<string> purchasedTalents = new();


    // ============================================================
    // FEATURE TRACKING
    // ============================================================

    private HashSet<string> characterFeatures = new();

    private HashSet<string> purchasedFeatures = new();
    private HashSet<string> initialFeatures = new();



    // ============================================================
    // CHARACTERISTIC IMPROVEMENT TRACKING
    // ============================================================

    // Number of purchased +5 improvements for each characteristic.
    //
    // Example:
    //
    // "STR" : 2
    //
    // means STR has been improved twice:
    //
    // +5
    // +5
    //
    // for a total of +10.
    private Dictionary<string, int>
        characteristicImprovementSteps =
            new();


    // ============================================================
    // CHARACTER DATA
    // ============================================================

    private int xpPool = 1000;

    private int xpSpent = 0;

    private int characterMP = 0;

    private int xpAdjustment = 50;


    private PowerLevelDto? selectedPowerLevel;

    private int allowedFeatures = 3;

    private string? selectedLocation;

    private string? selectedRace;

    private string? selectedBackground;

    private string? selectedTrade;

    private string? selectedMotivation;


    // ============================================================
    // FEATURES FROM CHARACTER CREATION
    // ============================================================

    private string? feature1;

    private string? feature2;

    private string? feature3;

    private string? feature4;

    private Dictionary<string, int> featureBonuses = new();


    // ============================================================
    // SKILLS
    // ============================================================

    private string? selectedAristocratSkill1;

    private string? selectedAristocratSkill2;

    private string? selectedScholarSkill;

    private string? selectedArtisanSkill;

    private string? selectedPleasureSkill;

    private List<TraitDto> traitList = new();
    private List<SkillDto> skillList = new();
    // ============================================================
    // XP
    // ============================================================

    private int xpRemaining =>
        Math.Max(
            0,
            xpPool - xpSpent);


    private int GetTotalMP()
    {
        return characterMP;
    }


    // ============================================================
    // ADD XP
    // ============================================================

    private async void AddCustomXP()
    {
        if (xpAdjustment <= 0)
            return;

        xpPool += xpAdjustment;

        await NotifyCharacterChanged();
    }


    // ============================================================
    // REMOVE XP
    // ============================================================

    private async void RemoveCustomXP()
    {
        if (xpAdjustment <= 0)
            return;

        var maximumRemoval =
            xpPool - xpSpent;

        if (maximumRemoval <= 0)
            return;

        var amountToRemove =
            Math.Min(
                xpAdjustment,
                maximumRemoval);

        xpPool -= amountToRemove;

        await NotifyCharacterChanged();

    }


    // ============================================================
    // CHARACTERISTIC HELPERS
    // ============================================================

    private int GetCharacteristicImprovementSteps(
        string characteristic)
    {
        if (characteristicImprovementSteps.TryGetValue(
                characteristic,
                out var steps))
        {
            return Math.Clamp(
                steps,
                0,
                MaximumCharacteristicImprovements);
        }

        return 0;
    }


    private int GetCharacteristicImprovementCost(
        string characteristic)
    {
        var steps =
            GetCharacteristicImprovementSteps(
                characteristic);

        return steps switch
        {
            0 => 250,
            1 => 500,
            2 => 750,
            3 => 1000,
            _ => 0
        };
    }


    private int GetCharacteristicValue(
        string characteristic)
    {
        if (Character == null)
            return 0;

        return characteristic switch
        {
            "MSK" => Character.CurrentStats["MSK"],
            "RSK" => Character.CurrentStats["RSK"],
            "STR" => Character.CurrentStats["STR"],
            "AGI" => Character.CurrentStats["AGI"],
            "CON" => Character.CurrentStats["CON"],
            "INT" => Character.CurrentStats["INT"],
            "PER" => Character.CurrentStats["PER"],
            "WPR" => Character.CurrentStats["WPR"],
            "CHA" => Character.CurrentStats["CHA"],
            _ => 0
        };
    }


    private void IncreaseCharacteristicValue(
    string characteristic)
    {
        if (Character == null)
            return;

        switch (characteristic)
        {
            case "MSK":
                Character.CurrentStats["MSK"] += 5;
                break;

            case "RSK":
                Character.CurrentStats["RSK"] += 5;
                break;

            case "STR":
                Character.CurrentStats["STR"] += 5;
                break;

            case "AGI":
                Character.CurrentStats["AGI"] += 5;
                break;

            case "CON":
                Character.CurrentStats["CON"] += 5;
                break;

            case "INT":
                Character.CurrentStats["INT"] += 5;
                break;

            case "PER":
                Character.CurrentStats["PER"] += 5;
                break;

            case "WPR":
                Character.CurrentStats["WPR"] += 5;
                break;

            case "CHA":
                Character.CurrentStats["CHA"] += 5;
                break;
        }
    }


    // ============================================================
    // CHARACTERISTIC TOGGLE
    // ============================================================

    private async Task OnCharacteristicToggled(
        string characteristic)
    {

        if (Character == null)
            return;

        var currentSteps =
            GetCharacteristicImprovementSteps(
                characteristic);

        // Maximum of four improvements.
        if (currentSteps >= MaximumCharacteristicImprovements)
            return;

        var xpCost =
            GetCharacteristicImprovementCost(
                characteristic);

        // Not enough XP.
        if (xpRemaining < xpCost)
            return;

        // Record the new improvement step.
        characteristicImprovementSteps[characteristic] =
            currentSteps + 1;

        // Apply exactly one +5 increase.
        IncreaseCharacteristicValue(
            characteristic);

        // Spend the XP for this step.
        xpSpent += xpCost;

        await NotifyCharacterChanged();
    }


    // ============================================================
    // MAGIC PROFICIENCY
    // ============================================================

    private bool IsMagicProficiency(
        string talentName)
    {
        return string.Equals(
            talentName,
            MagicProficiencyTalent,
            StringComparison.OrdinalIgnoreCase);
    }


    private int GetMagicProficiencyPurchases()
    {
        return purchasedTalents.Count(
            t => IsMagicProficiency(t));
    }


    private bool CanPurchaseMagicProficiency()
    {
        if (Character == null)
            return false;

        if (characterMP >= MaximumMP)
            return false;

        return xpRemaining >= MagicProficiencyXpCost;
    }


    private async Task OnMagicProficiencyToggled()
    {

        if (!CanPurchaseMagicProficiency())
            return;

        // Add another entry.
        //
        // This is intentionally a List so the same talent
        // can appear multiple times.
        purchasedTalents.Add(
            MagicProficiencyTalent);

        xpSpent +=
            MagicProficiencyXpCost;

        characterMP++;

        if (Character != null)
        {
            Character.MP =
                characterMP;
        }

        await NotifyCharacterChanged();
    }


    // ============================================================
    // SPELL TOGGLE
    // ============================================================

    private async Task OnSpellToggled(
        string? spellName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool value && value;

        if (string.IsNullOrWhiteSpace(spellName))
            return;


        if (isChecked)
        {
            if (purchasedSpells.Contains(
                    spellName))
            {
                return;
            }

            if (xpRemaining < xpCost)
                return;

            purchasedSpells.Add(
                spellName);

            xpSpent +=
                xpCost;
        }
        else
        {
            // Only XP-purchased spells can be refunded.
            if (purchasedSpells.Remove(
                    spellName))
            {
                xpSpent =
                    Math.Max(
                        0,
                        xpSpent - xpCost);
            }
        }


        RebuildLearnedSpells();

        await NotifyCharacterChanged();
    }


    // ============================================================
    // TALENT TOGGLE
    // ============================================================

    private async Task OnTalentToggled(
        string talentName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool value && value;

        if (string.IsNullOrWhiteSpace(
                talentName))
        {
            return;
        }

        // Magic Proficiency is handled separately because
        // it can be purchased repeatedly.
        if (IsMagicProficiency(talentName))
        {
            await OnMagicProficiencyToggled();
            return;
        }


        if (isChecked)
        {
            // Already owned from character creation.
            if (characterTalents.Contains(
                    talentName))
            {
                return;
            }

            // Already purchased with XP.
            if (purchasedTalents.Any(
                    t => string.Equals(
                        t,
                        talentName,
                        StringComparison.OrdinalIgnoreCase)))
            {
                return;
            }

            if (xpRemaining < xpCost)
                return;

            purchasedTalents.Add(
                talentName);

            xpSpent +=
                xpCost;
        }
        else
        {
            // Find the purchased instance.
            var purchasedTalent =
                purchasedTalents.FirstOrDefault(
                    t => string.Equals(
                        t,
                        talentName,
                        StringComparison.OrdinalIgnoreCase));

            if (purchasedTalent != null)
            {
                purchasedTalents.Remove(
                    purchasedTalent);

                xpSpent =
                    Math.Max(
                        0,
                        xpSpent - xpCost);
            }
        }


        await NotifyCharacterChanged();
    }


    // ============================================================
    // FEATURE TOGGLE
    // ============================================================

    private async Task OnFeatureToggled(
        string featureName,
        int xpCost,
        ChangeEventArgs e)
    {
        var isChecked =
            e.Value is bool value && value;

        if (string.IsNullOrWhiteSpace(
                featureName))
        {
            return;
        }


        if (isChecked)
        {
            // Already owned before XP purchases.
            if (characterFeatures.Contains(
                    featureName))
            {
                return;
            }

            // Already purchased.
            if (purchasedFeatures.Contains(
                    featureName))
            {
                return;
            }

            if (xpRemaining < xpCost)
                return;

            purchasedFeatures.Add(
                featureName);

            xpSpent +=
                xpCost;

            switch (featureName)
            {
                case "BardicPerformance":
                case "Channel":
                case "Counterspell":
                case "EldritchBlast":
                case "LayOnHands":
                case "Purify":
                case "Smite":
                    // Already purchased.
                    if (learnedSpells.Contains(
                            featureName))
                    {
                        return;
                    }
                    else
                    {
                        learnedSpells.Add(featureName);
                    }
                    break;
            }
        }
        else
        {
            if (purchasedFeatures.Remove(
                    featureName))
            {
                xpSpent =
                    Math.Max(
                        0,
                        xpSpent - xpCost);
            }
        }


        await NotifyCharacterChanged();
    }


    // ============================================================
    // UPDATE CHARACTER
    // ============================================================

    private async Task NotifyCharacterChanged()
    {
        if (Character == null)
            return;


        // ========================================================
        // XP
        // ========================================================

        Character.XpPool =
            xpPool;

        Character.XpSpent =
            xpSpent;


        // ========================================================
        // MP
        // ========================================================

        Character.MP =
            characterMP;


        // ========================================================
        // PURCHASED SPELLS
        // ========================================================

        Character.PurchasedSpells =
            purchasedSpells
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // LEARNED SPELLS
        // ========================================================

        Character.LearnedSpells =
            learnedSpells
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // PURCHASED TALENTS
        // ========================================================

        Character.PurchasedTalents =
            purchasedTalents
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .ToList();


        // ========================================================
        // ALL TALENTS
        // ========================================================

        var allTalents =
            new List<string>();

        characterTalents.RemoveWhere(
            talent => purchasedTalents.Any(
                purchased =>
                    string.Equals(
                        talent,
                        purchased,
                        StringComparison.OrdinalIgnoreCase)));
        // Existing talents.
        foreach (var talent in characterTalents)
        {
            if (!string.IsNullOrWhiteSpace(
                    talent))
            {
                allTalents.Add(
                    talent);
            }
        }

        // XP-purchased talents.
        //
        // Do NOT HashSet this because Magic Proficiency
        // can appear multiple times.
        foreach (var talent in purchasedTalents)
        {
            if (!string.IsNullOrWhiteSpace(
                    talent))
            {
                if (talent != "Magic Proficiency (X)")
                {
                    if(!allTalents.Contains(talent))
                        allTalents.Add(talent);

                }
                else
                {
                    allTalents.Add(talent);
                }
            }
        }

        Character.Talents =
            allTalents
                .ToList();


        // ========================================================
        // PURCHASED FEATURES
        // ========================================================

        Character.PurchasedFeatures =
            purchasedFeatures
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // ALL FEATURES
        // ========================================================

        Character.Features =
            characterFeatures
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .ToList();


        // ========================================================
        // CHARACTERISTIC IMPROVEMENT STEPS
        // ========================================================

        Character.CharacteristicImprovementSteps =
            new Dictionary<string, int>(
                characteristicImprovementSteps);


        // ========================================================
        // NOTIFY PARENT
        // ========================================================

        await OnCharacterChanged.InvokeAsync(
            Character);
    }


    // ============================================================
    // LOAD API DATA
    // ============================================================
    private string? GetFeatureDescription(string featureName)
    {
        return features
            .FirstOrDefault(x =>
                string.Equals(
                    x.Name,
                    featureName,
                    StringComparison.OrdinalIgnoreCase))
            ?.Description;
    }


    private string? GetTalentDescription(string talentName)
    {
        return talents
            .FirstOrDefault(x =>
                string.Equals(
                    x.Name,
                    talentName,
                    StringComparison.OrdinalIgnoreCase))
            ?.Description;
    }


    private string? GetTraitDescription(string traitName)
    {
        return traitList
            .FirstOrDefault(x =>
                string.Equals(
                    x.Name,
                    traitName,
                    StringComparison.OrdinalIgnoreCase))
            ?.Description;
    }


    private string? GetSkillDescription(string skillName)
    {
        return skillList
            .FirstOrDefault(x =>
                string.Equals(
                    x.Name,
                    skillName,
                    StringComparison.OrdinalIgnoreCase))
            ?.Description;
    }

    private string? GetSpellDescription(string spellName)
    {
        return spells
            .FirstOrDefault(x =>
                string.Equals(
                    x.Name,
                    spellName,
                    StringComparison.OrdinalIgnoreCase))
            ?.Description;
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            locations =
                await Http.GetFromJsonAsync<List<LocationDto>>(
                    "api/locations")
                ?? new List<LocationDto>();


            backgrounds =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/backgrounds")
                ?? new List<SimpleDto>();


            trades =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/trades")
                ?? new List<SimpleDto>();


            motivations =
                await Http.GetFromJsonAsync<List<SimpleDto>>(
                    "api/motivations")
                ?? new List<SimpleDto>();


            features =
                await Http.GetFromJsonAsync<List<FeatureDto>>(
                    "api/features")
                ?? new List<FeatureDto>();


            talents =
                await Http.GetFromJsonAsync<List<TalentDto>>(
                    "api/talents")
                ?? new List<TalentDto>();


            weapons =
                await Http.GetFromJsonAsync<List<WeaponDto>>(
                    "api/weapons")
                ?? new List<WeaponDto>();


            armors =
                await Http.GetFromJsonAsync<List<ArmorDto>>(
                    "api/armor")
                ?? new List<ArmorDto>();


            spells =
                await Http.GetFromJsonAsync<List<SpellDto>>(
                    "api/spells")
                ?? new List<SpellDto>();


            races =
                await Http.GetFromJsonAsync<List<RaceDto>>(
                    "api/races")
                ?? new List<RaceDto>();

            traitList =
                 await Http.GetFromJsonAsync<List<TraitDto>>(
                    "api/traits")
                ?? new List<TraitDto>();

            skillList =
                 await Http.GetFromJsonAsync<List<SkillDto>>(
                    "api/skills")
                ?? new List<SkillDto>();
        }
        catch
        {
            // Keep already initialized collections.
        }


        StateHasChanged();
    }


    // ============================================================
    // PARAMETERS
    // ============================================================

    [Parameter]
    public ClientCharacterDto? Character { get; set; }


    [Parameter]
    public EventCallback<ClientCharacterDto>
        OnCharacterChanged
    { get; set; }


    private bool characterLoaded = false;


    // ============================================================
    // CHARACTER PARAMETERS CHANGED
    // ============================================================

    protected override void OnParametersSet()
    {
        if (Character == null)
            return;

        LoadCharacterData(
            Character);
    }


    // ============================================================
    // LOAD CHARACTER
    // ============================================================

    private void LoadCharacterData(
        ClientCharacterDto dto)
    {
        // ========================================================
        // XP
        // ========================================================

        xpPool =
            Math.Max(
                0,
                dto.XpPool);

        xpSpent =
            Math.Max(
                0,
                dto.XpSpent);


        // ========================================================
        // PURCHASED SPELLS
        // ========================================================

        purchasedSpells =
            dto.PurchasedSpells != null
                ? new HashSet<string>(
                    dto.PurchasedSpells
                        .Where(s =>
                            !string.IsNullOrWhiteSpace(s)))
                : new HashSet<string>();


        // ========================================================
        // LEARNED SPELLS
        // ========================================================

        learnedSpells =
            dto.LearnedSpells != null
                ? new HashSet<string>(
                    dto.LearnedSpells
                        .Where(s =>
                            !string.IsNullOrWhiteSpace(s)))
                : new HashSet<string>();


        // ========================================================
        // EXISTING TALENTS
        // ========================================================

        characterTalents =
            dto.Talents != null
                ? new HashSet<string>(
                    dto.Talents
                        .Where(t =>
                            !string.IsNullOrWhiteSpace(t)))
                : new HashSet<string>();


        // ========================================================
        // PURCHASED TALENTS
        // ========================================================

        purchasedTalents =
            dto.PurchasedTalents != null
                ? new List<string>(
                    dto.PurchasedTalents
                        .Where(t =>
                            !string.IsNullOrWhiteSpace(t)))
                : new List<string>();


        // ========================================================
        // EXISTING FEATURES
        // ========================================================

        characterFeatures =
            dto.Features != null
                ? new HashSet<string>(
                    dto.Features
                        .Where(f =>
                            !string.IsNullOrWhiteSpace(f)))
                : new HashSet<string>();


        // ========================================================
        // PURCHASED FEATURES
        // ========================================================

        purchasedFeatures =
            dto.PurchasedFeatures != null
                ? new HashSet<string>(
                    dto.PurchasedFeatures
                        .Where(f =>
                            !string.IsNullOrWhiteSpace(f)))
                : new HashSet<string>();


        // ========================================================
        // CHARACTERISTIC IMPROVEMENTS
        // ========================================================

        characteristicImprovementSteps =
            dto.CharacteristicImprovementSteps != null
                ? new Dictionary<string, int>(
                    dto.CharacteristicImprovementSteps)
                : new Dictionary<string, int>();


        // ========================================================
        // CHARACTER CREATION DATA
        // ========================================================

        selectedRace =
            dto.Race;


        feature1 =
            dto.Features != null &&
            dto.Features.Count > 0
                ? dto.Features[0]
                : null;


        feature2 =
            dto.Features != null &&
            dto.Features.Count > 1
                ? dto.Features[1]
                : null;


        feature3 =
            dto.Features != null &&
            dto.Features.Count > 2
                ? dto.Features[2]
                : null;


        feature4 =
            dto.Features != null &&
            dto.Features.Count > 3
                ? dto.Features[3]
                : null;

        featureBonuses.Clear();
        foreach (var fname in characterFeatures)
        {
            var f =
                features.FirstOrDefault(
                    x => x.Name == fname);

            foreach (var cb in f.CharBonuses)
            {
                featureBonuses.TryGetValue(
                    cb,
                    out var cur);

                featureBonuses[cb] = cur + 5;
            }
        }
        // ========================================================
        // MP
        // ========================================================

        characterMP =
            dto.MP;


        characterLoaded =
            true;


        RebuildLearnedSpells();
    }


    // ============================================================
    // REBUILD LEARNED SPELLS
    // ============================================================

    private void RebuildLearnedSpells()
    {
        learnedSpells.Clear();


        // ========================================================
        // PURCHASED SPELLS
        // ========================================================

        foreach (var spell in purchasedSpells)
        {
            if (!string.IsNullOrWhiteSpace(
                    spell))
            {
                learnedSpells.Add(
                    spell);
            }
        }


        // ========================================================
        // RACE SPELLS
        // ========================================================

        var race =
            races.FirstOrDefault(
                r => r.Name == selectedRace);


        if (race != null)
        {
            foreach (var spell in race.Spells)
            {
                if (!string.IsNullOrWhiteSpace(
                        spell))
                {
                    learnedSpells.Add(
                        spell);
                }
            }
        }


        // ========================================================
        // FEATURE SPELLS
        // ========================================================

        var selectedFeatures =
            new[]
            {
                feature1,
                feature2,
                feature3,
                feature4
            };


        foreach (var fname in selectedFeatures)
        {
            if (string.IsNullOrEmpty(
                    fname))
            {
                continue;
            }


            switch (fname)
            {
                case "BardicPerformance":

                case "Channel":

                case "Counterspell":

                case "EldritchBlast":

                case "LayOnHands":

                case "Purify":

                case "Smite":

                    learnedSpells.Add(
                        fname);

                    break;
            }
        }
    }


