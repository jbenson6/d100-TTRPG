@page "/character-manager"
@using d100_TTRPG.Shared.Data_Objects

@rendermode InteractiveServer

<PageTitle>Character Manager</PageTitle>

<h1>Character Manager</h1>

<div class="container-fluid mt-3">

    <ul class="nav nav-tabs" id="characterManagerTabs" role="tablist">

        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="character-sheet-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#character-sheet"
                    type="button"
                    role="tab"
                    aria-controls="character-sheet"
                    aria-selected="true">

                Character Sheet

            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="character-improvements-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#character-improvements"
                    type="button"
                    role="tab"
                    aria-controls="character-improvements"
                    aria-selected="false">

                Character Improvements

            </button>
        </li>

    </ul>

    <div class="tab-content" id="characterManagerTabsContent">

        <!-- CHARACTER SHEET -->

        <div class="tab-pane fade show active"
             id="character-sheet"
             role="tabpanel"
             aria-labelledby="character-sheet-tab">

            <div class="mt-3">

                <CharacterSheet OnCharacterLoaded="OnCharacterLoaded" />

            </div>

        </div>

        <!-- CHARACTER IMPROVEMENTS -->

        <div class="tab-pane fade"
             id="character-improvements"
             role="tabpanel"
             aria-labelledby="character-improvements-tab">

            <div class="mt-3">

                <CharacterImprovement Character="loadedCharacter" />

            </div>

        </div>

    </div>

</div>

@code {

    private ClientCharacterDto? loadedCharacter;

    private void OnCharacterLoaded(
        ClientCharacterDto character)
    {
        loadedCharacter = character;
    }

}