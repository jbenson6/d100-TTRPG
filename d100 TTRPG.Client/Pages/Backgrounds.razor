@page "/backgrounds"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Backgrounds</PageTitle>

<h1>Backgrounds</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Skills</th>
                <th>Talent</th>
                <th>Description</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in backgrounds)
            {
                var skills = "";
                <tr>
                    <td>@b.Name</td>
                    @if (b.Skills != null)
                    {
                        @foreach (var s in b.Skills)
                        {
                            if (b.Skills.IndexOf(s) != b.Skills.Count - 1)
                                skills += s + ", ";
                            else
                                skills += s;
                        }
                    }
                    <td> @skills </td>
                    <td>@b.Talent</td>
                    <td>@b.Description</td>
                    <td>@b.AdditionalNotes</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<BackgroundDto> backgrounds = new();
    private bool loaded = false;
    private string? saveMessage = "Loading backgrounds...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            backgrounds = await Http.GetFromJsonAsync<List<BackgroundDto>>("api/backgrounds") ?? new List<BackgroundDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load backgrounds: {ex.Message}";

            loaded = true;
        }
        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class BackgroundDto
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? AdditionalNotes { get; set; }
        public List<string>? Skills { get; set; }
        public string Talent { get; set; }
    }
}
