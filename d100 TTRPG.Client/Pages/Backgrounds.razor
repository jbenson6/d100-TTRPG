@page "/backgrounds"
@rendermode InteractiveAuto

@inject HttpClient Http

<PageTitle>Backgrounds</PageTitle>

<h1>Backgrounds</h1>

@if (!loaded)
{
    <p>Loading backgrounds...</p>
}
else if (backgrounds == null || !backgrounds.Any())
{
    <p>No backgrounds available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in backgrounds)
            {
                <tr>
                    <td>@b.Name</td>
                    <td>@b.Description</td>
                    <td>@b.AdditionalNotes</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<BackgroundDto> backgrounds = new();
    private bool loaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        if (!OperatingSystem.IsBrowser())
        {
            loaded = true;
            return;
        }

        try
        {
            backgrounds = await Http.GetFromJsonAsync<List<BackgroundDto>>("api/backgrounds") ?? new List<BackgroundDto>();
        }
        catch
        {
            backgrounds = new List<BackgroundDto>();
        }

        loaded = true;
        StateHasChanged();
    }

    private class BackgroundDto
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? AdditionalNotes { get; set; }
    }
}
