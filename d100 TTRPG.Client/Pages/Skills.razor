@page "/skills"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Skills</PageTitle>

<h1>Skills</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in skills)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SimpleDto> skills = new();
    private bool loaded = false;
    private string? saveMessage = "Loading skills...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            skills = await Http.GetFromJsonAsync<List<SimpleDto>>("api/skills") ?? new List<SimpleDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load skills: {ex.Message}";

            loaded = true;
        }
        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class SimpleDto { public string? Name { get; set; } public string? Description { get; set; } }
}
