@page "/spells"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Spells</PageTitle>

<h1>Spells</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th @onclick="@(() => SortBy("Name"))" style="cursor:pointer;">
                    Name @SortIndicator("Name")
                </th>
                <th>XP</th>
                <th @onclick="@(() => SortBy("MP"))" style="cursor:pointer;">
                    MP @SortIndicator("MP")
                </th>
                <th>Difficulty</th>
                <th @onclick="@(() => SortBy("MagicSchool"))" style="cursor:pointer;">
                    School @SortIndicator("MagicSchool")
                </th>
                <th>Range</th>
                <th>Targets</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var s in spells)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.XpCost</td>
                    <td>@s.MP</td>
                    <td>@s.CastDifficulty</td>
                    <td>@s.MagicSchool</td>
                    <td>@s.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SpellDto> spells = new();
    private bool loaded = false;
    private string? saveMessage = "Loading spells...";

    private string currentSort = "MagicSchool";
    private bool sortAscending = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            spells = await Http.GetFromJsonAsync<List<SpellDto>>("api/spells")
                     ?? new List<SpellDto>();

            SortSpells();
        }
        catch (Exception ex)
        {
            saveMessage = $"Unable to load spells: {ex.Message}";
        }

        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private void SortBy(string column)
    {
        if (currentSort == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSort = column;
            sortAscending = true;
        }

        SortSpells();
    }

    private void SortSpells()
    {
        spells = currentSort switch
        {
            "Name" => sortAscending
                ? spells.OrderBy(s => s.Name).ToList()
                : spells.OrderByDescending(s => s.Name).ToList(),

            "MP" => sortAscending
                ? spells.OrderBy(s => s.MP).ToList()
                : spells.OrderByDescending(s => s.MP).ToList(),

            "MagicSchool" => sortAscending
                ? spells.OrderBy(s => s.MagicSchool).ToList()
                : spells.OrderByDescending(s => s.MagicSchool).ToList(),

            _ => spells
        };
    }

    private string SortIndicator(string column)
    {
        if (currentSort != column)
            return "";

        return sortAscending ? "▲" : "▼";
    }

    private class SpellDto
    {
        public string? Name { get; set; }
        public int XpCost { get; set; }
        public int MP { get; set; }
        public int CastDifficulty { get; set; }
        public string? MagicSchool { get; set; }
        public int Range { get; set; }
        public int NumTargets { get; set; }
        public string? Description { get; set; }
    }
}