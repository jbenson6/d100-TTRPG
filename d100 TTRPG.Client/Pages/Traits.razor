@page "/traits"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Traits</PageTitle>

<h1>Traits</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in traits)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.Type</td>
                    <td>@t.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TraitDto> traits = new();
    private bool loaded = false;
    private string? saveMessage = "Loading traits...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            traits = await Http.GetFromJsonAsync<List<TraitDto>>("api/traits") ?? new List<TraitDto>();
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load traits: {ex.Message}";
            loaded = true;
        }

        saveMessage = "";
        loaded = true;
        StateHasChanged();
    }

    private class TraitDto
    {
        public string? Name { get; set; }
        public string? Type { get; set; }
        public string? Description { get; set; }
    }
}
