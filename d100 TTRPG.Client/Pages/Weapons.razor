@page "/weapons"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Weapons</PageTitle>

<h1>Weapons</h1>

@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="mt-2 text-muted">
        @saveMessage
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Hands</th>
                <th>Range</th>
                <th>Damage</th>
                <th>Penetration</th>
                <th>Damage Types</th>
                <th>Traits</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in items)
            {
                <tr>
                    <td>@w.Name</td>
                    <td>@w.Hands</td>
                    <td>@w.Range</td>
                    <td>@w.Damage</td>
                    <td>@w.Penetration</td>
                    <td>@w.DamageTypes</td>
                    <td>@string.Join(", ", w.Traits)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WeaponDto> items = new();
    private bool loaded = false;
    private string? saveMessage = "Loading weapons...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        try
        {
            items =
                await Http.GetFromJsonAsync<List<WeaponDto>>(
                    "api/weapons")
                ?? new List<WeaponDto>();

            saveMessage = "";
        }
        catch (Exception ex)
        {
            saveMessage =
                $"Unable to load weapons: {ex.Message}";
        }

        loaded = true;
        StateHasChanged();
    }

    private class WeaponDto
    {
        public string? Name { get; set; }

        public string? Hands { get; set; }

        public string? Range { get; set; }

        public string? Damage { get; set; }

        public int Penetration { get; set; }

        public string? DamageTypes { get; set; }

        public List<string> Traits { get; set; } = new();
    }
}
