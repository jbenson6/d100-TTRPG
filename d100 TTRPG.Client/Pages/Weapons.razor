@page "/weapons"
@rendermode InteractiveAuto

@inject HttpClient Http

<PageTitle>Weapons</PageTitle>

<h1>Weapons</h1>

@if (!loaded)
{
    <p>Loading weapons...</p>
}
else if (items == null || !items.Any())
{
    <p>No weapons available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in items)
            {
                <tr>
                    <td>@w.Name</td>
                    <td>@w.Description</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SimpleDto> items = new();
    private bool loaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        if (!OperatingSystem.IsBrowser())
        {
            loaded = true;
            return;
        }

        try
        {
            items = await Http.GetFromJsonAsync<List<SimpleDto>>("api/weapons") ?? new List<SimpleDto>();
        }
        catch
        {
            items = new List<SimpleDto>();
        }

        loaded = true;
        StateHasChanged();
    }

    private class SimpleDto { public string? Name { get; set; } public string? Description { get; set; } }
}
