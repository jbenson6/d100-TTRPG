@page "/weapons"
@rendermode InteractiveAuto

@inject HttpClient Http

<PageTitle>Weapons</PageTitle>

<h1>Weapons</h1>

@if (!loaded)
{
    <p>Loading weapons...</p>
}
else if (items == null || !items.Any())
{
    <p>No weapons available.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Hands</th>
                <th>Range</th>
                <th>Damage</th>
                <th>Penetration</th>
                <th>Damage Types</th>
                <th>Traits</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in items)
            {
                <tr>
                    <td>@w.Name</td>
                    <td>@w.Hands</td>
                    <td>@w.Range</td>
                    <td>@w.Damage</td>
                    <td>@w.Penetration</td>
                    <td>@w.DamageTypes</td>
                    <td>@w.Traits</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WeaponDto> items = new();
    private bool loaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        if (!OperatingSystem.IsBrowser())
        {
            loaded = true;
            return;
        }

        try
        {
            items = await Http.GetFromJsonAsync<List<WeaponDto>>("api/weapons") ?? new List<WeaponDto>();
        }
        catch
        {
            items = new List<WeaponDto>();
        }

        loaded = true;
        StateHasChanged();
    }

    private class WeaponDto
    {
        public string? Name { get; set; }
        public string? Hands { get; set; }
        public string? Range { get; set; }
        public string? Damage { get; set; }
        public int Penetration { get; set; }
        public string? DamageTypes { get; set; }
        public string? Traits { get; set; }
    }
}
