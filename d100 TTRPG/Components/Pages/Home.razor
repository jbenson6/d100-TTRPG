@page "/"
@using d100_TTRPG.Services

<PageTitle>Tao's d100 TTRPG</PageTitle>

<div class="home-page">

    <section class="hero">
        <h1>Tao's d100 TTRPG</h1>

        <p class="hero-subtitle">
            Create, manage, and adventure with your characters
            in the world of the d100 TTRPG.
        </p>

        <div class="version">
            Version @AppVersion.Current
        </div>
    </section>

    <section class="features">

        <div class="feature-card">
            <div class="feature-icon">⚔️</div>
            <h2>Character Creation</h2>
            <p>
                Build unique characters by selecting their race,
                background, trade, motivation, skills, talents,
                traits, spells, and equipment.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">📜</div>
            <h2>Character Management</h2>
            <p>
                Save your characters locally and continue improving
                them as they gain experience.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🎲</div>
            <h2>Your Adventure</h2>
            <p>
                Everything you need to build and manage your
                characters for your next d100 adventure.
            </p>
        </div>

    </section>

    <section class="get-started">
        <h2>Ready to Begin?</h2>

        <p>
            Create a new character or load an existing one to get started.
        </p>

        <div class="actions">

            <a href="/character-manager" class="secondary-button">
                Character Manager
            </a>
        </div>
    </section>

</div>

<style>
    .home-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 60px;
        color: #222;
    }

    .hero {
        text-align: center;
        background: #f3f4f6;
        border: 1px solid #d5d7da;
        border-radius: 16px;
        padding: 60px 30px;
        margin-bottom: 40px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

        .hero h1 {
            margin: 0 0 18px;
            color: #1f2937;
            font-size: 42px;
            font-weight: 700;
        }

    .hero-subtitle {
        max-width: 700px;
        margin: 0 auto 24px;
        color: #4b5563;
        font-size: 19px;
        line-height: 1.6;
    }

    .version {
        display: inline-block;
        padding: 7px 16px;
        border: 1px solid #c7cbd1;
        border-radius: 20px;
        background: #ffffff;
        color: #4b5563;
        font-size: 14px;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }

    .feature-card {
        background: #ffffff;
        border: 1px solid #d5d7da;
        border-radius: 12px;
        padding: 28px 24px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    }

    .feature-icon {
        font-size: 28px;
        margin-bottom: 12px;
    }

    .feature-card h2 {
        margin: 0 0 12px;
        color: #1f2937;
        font-size: 21px;
    }

    .feature-card p {
        margin: 0;
        color: #4b5563;
        line-height: 1.6;
        font-size: 16px;
    }

    .get-started {
        text-align: center;
        border-top: 1px solid #d5d7da;
        padding-top: 38px;
    }

        .get-started h2 {
            margin: 0 0 10px;
            color: #1f2937;
            font-size: 32px;
        }

        .get-started p {
            margin: 0 0 26px;
            color: #6b7280;
            font-size: 16px;
        }

    .actions {
        display: flex;
        justify-content: center;
        gap: 14px;
    }

    .primary-button,
    .secondary-button {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.15s ease;
    }

    .primary-button {
        background: #374151;
        color: #ffffff;
    }

        .primary-button:hover {
            background: #1f2937;
            color: #ffffff;
        }

    .secondary-button {
        background: #ffffff;
        color: #374151;
        border: 1px solid #9ca3af;
    }

        .secondary-button:hover {
            background: #f3f4f6;
            color: #111827;
        }
</style>

@code {
    // No code required.
}