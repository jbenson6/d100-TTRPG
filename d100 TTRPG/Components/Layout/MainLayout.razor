@inherits LayoutComponentBase
@rendermode InteractiveServer
@using d100_TTRPG.Services
@inject UpdateService UpdateService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">
                About
            </a>
        </div>

        @if (UpdateService.UpdateAvailable)
        {
            <div class="alert alert-info m-3 d-flex align-items-center justify-content-between">
                <div>
                    <strong>Update available!</strong>
                    <span class="ms-2">
                        Version @UpdateService.LatestVersion is available.
                    </span>
                </div>

                <button class="btn btn-primary"
                        @onclick="InstallUpdate">
                    Update Now
                </button>
            </div>
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        _ = CheckForUpdateInBackground();
    }

    private async Task CheckForUpdateInBackground()
    {
        await UpdateService.CheckForUpdateAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task InstallUpdate()
    {
        await UpdateService.InstallUpdateAsync();
    }
}